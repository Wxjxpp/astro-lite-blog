{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@lib/*": ["src/lib/*"],
      "@styles/*": ["src/styles/*"],
      "@types/*": ["src/types/*"]
    },
    "jsx": "preserve",
    "verbatimModuleSyntax": true
  },
  "include": ["src/**/*", "*.d.ts"],
  "exclude": ["dist", "node_modules"]
}
