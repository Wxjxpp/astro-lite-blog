---
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/500.css';
import '@fontsource/noto-serif-sc/700.css';
import '@fontsource/mona-sans/400.css';
import '@fontsource/mona-sans/500.css';
import '@fontsource/mona-sans/600.css';
import '@fontsource/mona-sans/700.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '@fontsource/geist-mono/600.css';
import '@styles/global.css';
import '@styles/enhance.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import SearchDialog from '@components/SearchDialog.astro';
import { SITE_CONFIG } from '@lib/utils';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string; description?: string; image?: string;
  type?: 'website' | 'article'; canonical?: string; noindex?: boolean;
  /** Client-side page transitions (cross-fade). Turn off for pages with heavy page-level scripts, e.g. the CMS. */
  transitions?: boolean;
}
const { title, description = SITE_CONFIG.description, image, type = 'website', canonical, noindex = false, transitions = true } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_CONFIG.title}` : SITE_CONFIG.title;
const canonicalUrl = canonical || new URL(Astro.url.pathname, SITE_CONFIG.url).toString();
const ogImage = image || new URL('/og-image.png', SITE_CONFIG.url).toString();

---
<!DOCTYPE html>
<html lang="zh-CN" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content={Astro.generator} />
  <title>{pageTitle}</title>
  {transitions && <ClientRouter />}
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content={SITE_CONFIG.title} />
  <meta property="og:locale" content="zh_CN" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title={SITE_CONFIG.title} href="/rss.xml" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/misans@5.0.0/lib/Normal/MiSans-Medium.min.css" crossorigin="anonymous" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" crossorigin="anonymous" />
  <script is:inline>
    /* Dark-first: dark unless the visitor chose light or "follow system". */
    (function () {
      var d = document.documentElement, pref = 'dark';
      try { var v = localStorage.getItem('theme'); if (v === 'light' || v === 'dark' || v === 'system') pref = v; } catch (e) {}
      var eff = pref === 'system' ? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark') : pref;
      d.setAttribute('data-theme-pref', pref);
      d.setAttribute('data-theme', eff);
    })();
  </script>
</head>
<body>
  <Header />
  <main class="main-content"><slot /></main>
  <Footer />
  <SearchDialog />
  <button class="back-to-top" id="backToTop" aria-label="回到顶部"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg></button>
  <div class="lightbox" id="lightbox"><button class="lightbox-close" aria-label="关闭">&times;</button><img id="lightbox-img" src="" alt="" /></div>
  <!-- Loading state for slow client-side navigations: a progress line plus a
       skeleton that stands in for the page content until the real page swaps in. -->
  <div class="nav-progress" aria-hidden="true"></div>
  <div class="skeleton-layer" aria-hidden="true"></div>
  <script>
    /* With <ClientRouter /> the <body> is swapped on every navigation but this
       module only runs once. So: element-level listeners are (re)bound on each
       page load, while window/document-level listeners are registered once. */
    const onPageReady = (fn: () => void) => {
      if (document.querySelector('meta[name="astro-view-transitions-enabled"]')) {
        document.addEventListener('astro:page-load', fn);
      } else if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', fn, { once: true });
      } else {
        fn();
      }
    };

    const setMenuOpen = (open: boolean) => {
      const btn = document.getElementById('mobileMenuBtn');
      const nav = document.getElementById('navMenu');
      const backdrop = document.getElementById('navBackdrop');
      if (!btn || !nav) return;
      nav.classList.toggle('open', open);
      backdrop?.classList.toggle('open', open);
      btn.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
      document.body.style.overflow = open ? 'hidden' : '';
    };
    const closeLightbox = () => {
      document.getElementById('lightbox')?.classList.remove('open');
      document.body.style.overflow = '';
    };

    /* ---- Theme: system / light / dark, with a bottom-to-top "curtain" reveal ---- */
    const mq = window.matchMedia('(prefers-color-scheme: light)');
    const resolveTheme = (pref: string) => (pref === 'system' ? (mq.matches ? 'light' : 'dark') : pref);
    const applyTheme = (pref: string) => {
      const root = document.documentElement;
      root.setAttribute('data-theme-pref', pref);
      root.setAttribute('data-theme', resolveTheme(pref));
      try { localStorage.setItem('theme', pref); } catch (e) { /* ignore */ }
      syncThemeMenu();
    };
    const syncThemeMenu = () => {
      const pref = document.documentElement.getAttribute('data-theme-pref') || 'dark';
      document.querySelectorAll<HTMLElement>('.theme-item').forEach(b => b.setAttribute('aria-checked', String(b.dataset.pref === pref)));
    };
    const curtain = (update: () => void) => {
      const root = document.documentElement;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const start = (document as any).startViewTransition?.bind(document);
      if (!start || reduced) return update();
      root.classList.add('theme-curtain');
      const t = start(update);
      // the new theme is revealed from the bottom edge upwards, like a curtain being drawn
      t.ready.then(() => {
        root.animate(
          { clipPath: ['inset(100% 0 0 0)', 'inset(0 0 0 0)'] },
          { duration: 1000, easing: 'cubic-bezier(0.65, 0, 0.18, 1)', pseudoElement: '::view-transition-new(root)' },
        );
      }).catch(() => {});
      t.finished.finally(() => root.classList.remove('theme-curtain'));
    };
    const setThemeMenu = (open: boolean) => {
      const box = document.getElementById('themeSwitch');
      const btn = document.getElementById('themeToggle');
      if (!box || !btn) return;
      box.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
    };
    let themeGlobalsBound = false;
    const initTheme = () => {
      syncThemeMenu();
      const btn = document.getElementById('themeToggle');
      const menu = document.getElementById('themeMenu');
      if (btn && menu) {
        btn.addEventListener('click', e => {
          e.stopPropagation();
          setThemeMenu(!document.getElementById('themeSwitch')?.classList.contains('open'));
        });
        menu.addEventListener('click', e => {
          const item = (e.target as HTMLElement).closest<HTMLElement>('.theme-item');
          if (!item) return;
          const pref = item.dataset.pref || 'dark';
          setThemeMenu(false);
          if (resolveTheme(pref) === document.documentElement.getAttribute('data-theme')) applyTheme(pref); // same look: no curtain
          else curtain(() => applyTheme(pref));
        });
        menu.addEventListener('keydown', e => {
          const items = Array.from(menu.querySelectorAll<HTMLElement>('.theme-item'));
          const i = items.indexOf(document.activeElement as HTMLElement);
          if (e.key === 'ArrowDown') { e.preventDefault(); items[(i + 1) % items.length].focus(); }
          if (e.key === 'ArrowUp') { e.preventDefault(); items[(i - 1 + items.length) % items.length].focus(); }
        });
      }
      if (themeGlobalsBound) return;
      themeGlobalsBound = true;
      document.addEventListener('click', e => { if (!(e.target as HTMLElement).closest('#themeSwitch')) setThemeMenu(false); });
      document.addEventListener('keydown', e => { if (e.key === 'Escape') { setThemeMenu(false); } });
      // while on "follow system", react to the OS switching light/dark
      mq.addEventListener('change', () => {
        if (document.documentElement.getAttribute('data-theme-pref') === 'system') curtain(() => applyTheme('system'));
      });
    };


    /* ---- Odometer: digits roll up to their value ---- */
    const initOdometer = () => {
      document.querySelectorAll<HTMLElement>('.odo[data-value]:not([data-ready])').forEach(el => {
        const value = el.dataset.value || '0';
        el.dataset.ready = '1';
        el.setAttribute('role', 'text');
        el.setAttribute('aria-label', value);
        el.textContent = '';
        [...value].forEach((ch, i) => {
          const col = document.createElement('span');
          col.className = 'odo-col';
          col.setAttribute('aria-hidden', 'true');
          if (/\d/.test(ch)) {
            const strip = document.createElement('span');
            strip.className = 'odo-strip';
            strip.style.setProperty('--to', ch);
            strip.style.setProperty('--i', String(i));
            for (let n = 0; n <= 9; n++) { const d = document.createElement('span'); d.textContent = String(n); strip.appendChild(d); }
            col.appendChild(strip);
          } else col.textContent = ch;
          el.appendChild(col);
        });
        requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('is-rolling')));
      });
    };

    /* ---- Press feedback: every button squashes on press and springs back on release ---- */
    const PRESS = 'button:not(:disabled), a.nav-link, a.footer-link, a.site-logo, .icon-btn, [data-press]';
    const SPRING_EASING = getComputedStyle(document.documentElement).getPropertyValue('--spring').trim();
    const springBack = (el: HTMLElement, from: string) => {
      const frames = { scale: [from, '1'] };
      try { el.animate(frames, { duration: 650, easing: SPRING_EASING || 'cubic-bezier(0.34, 1.56, 0.64, 1)' }); }
      catch { el.animate(frames, { duration: 450, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)' }); }
    };
    if (!(window as any).__pressBound && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      (window as any).__pressBound = true;
      let pressed: HTMLElement | null = null;
      document.addEventListener('pointerdown', e => {
        const el = (e.target as HTMLElement).closest<HTMLElement>(PRESS);
        if (!el || el.closest('.cms-page textarea')) return;
        pressed = el;
        el.getAnimations().filter(a => (a as any).id === 'press').forEach(a => a.cancel());
        const a = el.animate({ scale: ['1', '0.9'] }, { duration: 110, easing: 'ease-out', fill: 'forwards', id: 'press' } as any);
        a.finished.catch(() => {});
      }, { passive: true });
      const release = () => {
        const el = pressed; pressed = null;
        if (!el) return;
        el.getAnimations().filter(a => (a as any).id === 'press').forEach(a => a.cancel());
        springBack(el, '0.9');
      };
      document.addEventListener('pointerup', release, { passive: true });
      document.addEventListener('pointercancel', release, { passive: true });
    }

    const initMobileMenu = () => {
      const btn = document.getElementById('mobileMenuBtn');
      const nav = document.getElementById('navMenu');
      const backdrop = document.getElementById('navBackdrop');
      if (!btn || !nav) return;
      btn.addEventListener('click', () => setMenuOpen(!nav.classList.contains('open')));
      backdrop?.addEventListener('click', () => setMenuOpen(false));
      nav.querySelectorAll('a').forEach(l => l.addEventListener('click', () => setMenuOpen(false)));
    };

    /* Header condensing (--p) + back-to-top visibility, driven by scroll. */
    const RANGE = 140; // px of scrolling for the header to finish condensing
    const updateScrollChrome = () => {
      const root = document.documentElement;
      const y = Math.max(0, window.scrollY);
      const t = Math.min(1, y / RANGE);
      const p = t * t * (3 - 2 * t); // smoothstep: eases in and out
      root.style.setProperty('--p', p.toFixed(3));
      root.toggleAttribute('data-scrolled', y > 28);
      document.getElementById('backToTop')?.classList.toggle('visible', y > 400);
    };

    const initBackToTop = () => {
      document.getElementById('backToTop')?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    };


    /* External links in articles go through the /go interstitial in a new tab. */
    const initExternalLinks = () => {
      const bare = (h: string) => h.replace(/^www\./, '');
      document.querySelectorAll<HTMLAnchorElement>('.markdown-content a[href]').forEach(a => {
        if (a.dataset.external) return;
        let u: URL;
        try { u = new URL(a.getAttribute('href') || '', location.href); } catch { return; }
        if (!/^https?:$/.test(u.protocol) || bare(u.hostname) === bare(location.hostname)) return;
        a.dataset.external = u.href;
        a.href = '/go?url=' + encodeURIComponent(u.href);
        a.target = '_blank';
        a.rel = 'noopener noreferrer nofollow';
      });
    };

    /* Two (or more) images with nothing between them are joined into one row, two per row. */
    const groupImages = () => {
      const imageOnly = (p: Element): Element[] | null => {
        if (p.tagName !== 'P') return null;
        const imgs = Array.from(p.querySelectorAll('img'));
        if (!imgs.length) return null;
        const probe = p.cloneNode(true) as HTMLElement;
        probe.querySelectorAll('img, br').forEach(n => n.remove());
        if (probe.textContent?.trim()) return null;
        if (!Array.from(probe.children).every(c => c.tagName === 'A')) return null;
        // keep a wrapping link together with its image
        return imgs.map(img => (img.parentElement && img.parentElement !== p && img.parentElement.tagName === 'A' ? img.parentElement : img));
      };
      document.querySelectorAll<HTMLElement>('.markdown-content').forEach(root => {
        const kids = Array.from(root.children);
        let i = 0;
        while (i < kids.length) {
          const first = imageOnly(kids[i]);
          if (!first) { i++; continue; }
          const paras: Element[] = [];
          const items: Element[] = [];
          let j = i;
          for (let it = imageOnly(kids[j]); it; it = j < kids.length ? imageOnly(kids[j]) : null) {
            paras.push(kids[j]); items.push(...it); j++;
          }
          if (items.length >= 2) {
            const anchor = paras[0];
            const frag = document.createDocumentFragment();
            for (let k = 0; k < items.length; k += 2) {
              const pair = items.slice(k, k + 2);
              if (pair.length === 2) {
                const row = document.createElement('div');
                row.className = 'img-row';
                pair.forEach(el => {
                  const img = (el.tagName === 'IMG' ? el : el.querySelector('img')) as HTMLImageElement;
                  const fit = () => { if (img.naturalWidth && img.naturalHeight) el.setAttribute('style', `flex:${(img.naturalWidth / img.naturalHeight).toFixed(3)} 1 0`); };
                  img.complete ? fit() : img.addEventListener('load', fit, { once: true });
                  row.appendChild(el);
                });
                frag.appendChild(row);
              } else {
                const p = document.createElement('p');
                p.appendChild(pair[0]);
                frag.appendChild(p);
              }
            }
            anchor.before(frag);
            paras.forEach(p => p.remove());
          }
          i = j;
        }
      });
    };

    const initImages = () => {
      groupImages();
      initExternalLinks();
      const imgs = document.querySelectorAll('img[loading="lazy"]');
      if ('IntersectionObserver' in window) {
        const o = new IntersectionObserver(entries => {
          entries.forEach(en => {
            if (en.isIntersecting) { en.target.classList.add('loaded'); o.unobserve(en.target); }
          });
        }, { rootMargin: '100px' });
        imgs.forEach(i => o.observe(i));
      } else {
        imgs.forEach(i => i.classList.add('loaded'));
      }
      const lb = document.getElementById('lightbox');
      const li = document.getElementById('lightbox-img') as HTMLImageElement | null;
      if (!lb || !li) return;
      document.querySelectorAll<HTMLImageElement>('.markdown-content img').forEach(i => {
        i.addEventListener('click', () => {
          li.src = i.src; li.alt = i.alt;
          lb.classList.add('open');
          document.body.style.overflow = 'hidden';
        });
      });
      lb.addEventListener('click', closeLightbox);
      document.querySelector('.lightbox-close')?.addEventListener('click', closeLightbox);
    };

    /* ---- registered once ---- */
    let scrollTicking = false;
    window.addEventListener('scroll', () => {
      if (scrollTicking) return;
      scrollTicking = true;
      requestAnimationFrame(() => { scrollTicking = false; updateScrollChrome(); });
    }, { passive: true });
    window.addEventListener('resize', () => { if (window.innerWidth > 768) setMenuOpen(false); });
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') { setMenuOpen(false); closeLightbox(); }
    });

    /* A swap replaces <html> attributes with the incoming page's, which would
       reset the theme to the server default. Carry the current one across. */
    document.addEventListener('astro:before-swap', e => {
      const theme = document.documentElement.getAttribute('data-theme');
      const pref = document.documentElement.getAttribute('data-theme-pref');
      if (theme) (e as any).newDocument.documentElement.setAttribute('data-theme', theme);
      if (pref) (e as any).newDocument.documentElement.setAttribute('data-theme-pref', pref);
    });
    document.addEventListener('astro:after-swap', updateScrollChrome);

    /* Loading state: only shown when a navigation is still pending after a short
       delay, so quick page changes never flash it. The skeleton matches the page
       being navigated *to*. The attributes live on <html>, which the swap
       resets, and are also cleared explicitly below. */
    const LOADER_DELAY = 300;
    let loaderTimer = 0;
    const skeletonFor = (url: URL) => {
      const path = url.pathname.replace(/\/+$/, '') || '/';
      if (path === '/') return 'home';
      if (path === '/categories' || path === '/tags') return 'grid';
      if (path.startsWith('/posts/')) return 'article';
      if (path === '/posts' || path.startsWith('/categories/') || path.startsWith('/tags/')) return 'list';
      return 'text';
    };

    /* ---- Skeleton markup is built here, not shipped in every HTML page ---- */
    const sk = (w: string, h = '', cls = '') => `<span class="sk ${cls}" style="width:${w};${h ? `height:${h}` : ''}"></span>`;
    const skCard = (t: string, l1: string, l2: string, tags: number) =>
      `<div class="sk-panel"><div class="sk-row"><span class="sk sk-chip"></span><span class="sk sk-date"></span></div>${sk(t, '', 'sk-title')}${sk(l1, '', 'sk-line')}${sk(l2, '', 'sk-line')}<div class="sk-row">${'<span class="sk sk-tag"></span>'.repeat(tags)}</div></div>`;
    const skHead = (w = '') => `<div class="page-header"><span class="sk sk-page-title" ${w ? `style="width:${w}"` : ''}></span><span class="sk sk-page-desc"></span></div>`;
    const skBody = (ws: string[]) => ws.map(w => sk(w, '', 'sk-line sk-body')).join('');
    const SKELETONS: Record<string, () => string> = {
      home: () => `<div class="container sk-view"><section class="hero-section"><div class="hero-copy">${sk('40%', '', 'sk-hero-line')}${sk('70%', '', 'sk-hero-line')}<div class="hero-stats">${'<span class="sk sk-stat"></span>'.repeat(3)}</div></div><div class="hero-orb-wrap"><span class="sk sk-circle"></span></div></section><div class="section-head">${sk('7rem', '1.6rem')}${sk('6rem', '1rem')}</div><div class="posts-list">${skCard('62%', '92%', '64%', 3)}${skCard('48%', '88%', '56%', 2)}</div></div>`,
      list: () => `<div class="container sk-view">${skHead()}<div class="posts-list">${skCard('62%', '92%', '64%', 3)}${skCard('48%', '88%', '56%', 2)}${skCard('70%', '90%', '60%', 3)}</div></div>`,
      grid: () => `<div class="container sk-view">${skHead()}<div class="category-grid">${['46', '38', '52', '42', '34', '48'].map(w => `<div class="sk-panel sk-tile">${sk(w + '%', '1.2rem')}${sk('30%', '0.85rem')}</div>`).join('')}</div></div>`,
      article: () => `<div class="container-narrow sk-view"><div class="post-header"><span class="sk sk-chip"></span>${sk('94%', '', 'sk-post-title')}${sk('58%', '', 'sk-post-title')}<div class="sk-row sk-meta">${sk('6.5rem', '0.85rem')}${sk('5rem', '0.85rem')}${sk('5.5rem', '0.85rem')}</div></div>${skBody(['100%', '96%', '88%', '100%', '42%'])}${sk('36%', '1.7rem')}${skBody(['100%', '92%', '97%', '64%'])}</div>`,
      text: () => `<div class="container-narrow sk-view">${skHead('40%')}${skBody(['100%', '94%', '98%', '56%', '100%', '90%', '72%'])}</div>`,
    };
    const ensureSkeleton = (kind: string) => {
      const layer = document.querySelector<HTMLElement>('.skeleton-layer');
      if (!layer || layer.dataset.kind === kind) return;
      layer.innerHTML = (SKELETONS[kind] || SKELETONS.text)();
      layer.dataset.kind = kind;
    };
    const stopLoader = () => {
      window.clearTimeout(loaderTimer);
      document.documentElement.removeAttribute('data-navigating');
      document.documentElement.removeAttribute('data-skeleton');
    };
    document.addEventListener('astro:before-preparation', e => {
      const kind = skeletonFor((e as any).to as URL);
      window.clearTimeout(loaderTimer);
      loaderTimer = window.setTimeout(() => {
        ensureSkeleton(kind);
        document.documentElement.setAttribute('data-skeleton', kind);
        document.documentElement.setAttribute('data-navigating', '');
      }, LOADER_DELAY);
    });
    document.addEventListener('astro:after-swap', stopLoader);
    document.addEventListener('astro:page-load', stopLoader);

    /* ---- bound on every page load ---- */
    onPageReady(() => { initTheme(); initOdometer(); initMobileMenu(); initBackToTop(); initImages(); updateScrollChrome(); });
  </script>
</body>
</html>
