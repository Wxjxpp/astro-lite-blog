---
import { SITE_CONFIG, SOCIAL_LINKS, NAV_MENU } from '@lib/utils';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <nav class="footer-links">
      {NAV_MENU.map(item => (<a href={item.href} class="footer-link">{item.label}</a>))}
    </nav>
    <div class="footer-links">
      {SOCIAL_LINKS.map(link => (
        <a href={link.url} class="footer-link" target="_blank" rel="noopener noreferrer">{link.name}</a>
      ))}
    </div>
    <p class="footer-copyright">&copy; {currentYear} {SITE_CONFIG.title} — Built with Astro.</p>
  </div>
</footer>