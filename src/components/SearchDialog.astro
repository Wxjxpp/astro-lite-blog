---
/* Site-wide search. Opened by any [data-search-open] element, Ctrl/Cmd+K, or "/". */
---
<div class="search-dialog" id="searchDialog" role="dialog" aria-modal="true" aria-label="搜索文章" aria-hidden="true">
  <div class="search-panel">
    <div class="search-status" id="searchStatus" aria-live="polite"></div>
    <div class="search-results" id="searchResults" role="listbox"></div>
    <div class="search-hints" aria-hidden="true">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
      <span><kbd>↵</kbd> 打开</span>
      <span><kbd>Esc</kbd> 关闭</span>
    </div>
  </div>
</div>

<script>
  type Item = { t: string; d: string; s: string; c: string; g: string[]; p: string };

  const w = window as any;
  if (!w.__searchBound) {
    w.__searchBound = true;

    let data: Item[] | null = null;
    let loading: Promise<Item[]> | null = null;
    let active = -1;

    const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
    const esc = (s: string) =>
      s.replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[ch] as string);
    const fmt = (iso: string) => {
      const d = new Date(iso);
      return isNaN(d.getTime()) ? '' : d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
    };

    const load = () => {
      if (data) return Promise.resolve(data);
      loading ??= fetch('/search.json')
        .then(r => {
          if (!r.ok) throw new Error(String(r.status));
          return r.json();
        })
        .then(j => (data = j.posts as Item[]))
        .catch(err => {
          loading = null;
          throw err;
        });
      return loading;
    };

    /* Highlight matches without ever injecting unescaped text. */
    const highlight = (text: string, terms: string[]) => {
      if (!terms.length) return esc(text);
      const re = new RegExp(`(${terms.map(t => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|')})`, 'gi');
      return text
        .split(re)
        .map((part, i) => (i % 2 ? `<mark>${esc(part)}</mark>` : esc(part)))
        .join('');
    };

    const score = (item: Item, terms: string[]) => {
      const title = item.t.toLowerCase();
      const desc = item.d.toLowerCase();
      const cat = item.c.toLowerCase();
      const tags = item.g.map(x => x.toLowerCase());
      let total = 0;
      for (const term of terms) {
        let hit = 0;
        if (title.includes(term)) hit += title.startsWith(term) ? 7 : 5;
        if (cat.includes(term)) hit += 3;
        if (tags.some(x => x.includes(term))) hit += 3;
        if (desc.includes(term)) hit += 1;
        if (!hit) return 0; // every word must match somewhere
        total += hit;
      }
      return total;
    };

    const setActive = (index: number, scroll = true) => {
      const links = [...document.querySelectorAll<HTMLElement>('#searchResults .search-result')];
      if (!links.length) {
        active = -1;
        return;
      }
      active = (index + links.length) % links.length;
      links.forEach((el, i) => {
        const on = i === active;
        el.classList.toggle('active', on);
        el.setAttribute('aria-selected', String(on));
        if (on && scroll) el.scrollIntoView({ block: 'nearest' });
      });
    };

    const render = (query: string) => {
      const box = $('searchResults');
      const status = $('searchStatus');
      if (!box || !status || !data) return;
      const terms = query.trim().toLowerCase().split(/\s+/).filter(Boolean);

      let list: Item[];
      if (!terms.length) {
        list = data.slice(0, 6);
        status.textContent = data.length ? '最近文章' : '还没有文章';
      } else {
        list = data
          .map(item => ({ item, s: score(item, terms) }))
          .filter(x => x.s > 0)
          .sort((a, b) => b.s - a.s)
          .map(x => x.item)
          .slice(0, 30);
        status.textContent = list.length ? `找到 ${list.length} 篇相关文章` : `没有找到与“${query.trim()}”相关的文章`;
      }

      box.innerHTML = list
        .map(
          (item, i) => `
        <a class="search-result" id="sr-${i}" role="option" aria-selected="false" href="/posts/${encodeURIComponent(item.s)}">
          <span class="search-result-meta">${esc(item.c)} · ${esc(fmt(item.p))}</span>
          <span class="search-result-title">${highlight(item.t, terms)}</span>
          <span class="search-result-desc">${highlight(item.d, terms)}</span>
          ${item.g.length ? `<span class="search-result-tags">${item.g.slice(0, 4).map(t => `<i>#${highlight(t, terms)}</i>`).join('')}</span>` : ''}
        </a>`,
        )
        .join('');
      active = -1;
      if (terms.length && list.length) setActive(0, false);
    };

    const isOpen = () => $('searchDialog')?.classList.contains('open') ?? false;

    const open = () => {
      const dialog = $('searchDialog');
      const input = $<HTMLInputElement>('searchInput');
      if (!dialog || !input) return;
      const root = document.documentElement;
      window.clearTimeout((w.__searchAnimTimer as number) || 0);
      root.setAttribute('data-search-anim', '');
      root.setAttribute('data-search', '');
      input.tabIndex = 0;
      dialog.classList.add('open');
      dialog.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      input.focus({ preventScroll: true });
      input.select();
      // some browsers need a frame before a just-shown element accepts focus
      requestAnimationFrame(() => {
        if (document.activeElement !== input) input.focus({ preventScroll: true });
      });
      const status = $('searchStatus');
      if (status && !data) status.textContent = '加载中…';
      load()
        .then(() => render(input.value))
        .catch(() => {
          if (status) status.textContent = '搜索索引加载失败，请稍后重试';
        });
    };

    const close = () => {
      const dialog = $('searchDialog');
      if (!dialog) return;
      const root = document.documentElement;
      root.removeAttribute('data-search');
      // keep the transition rules alive until the spring has settled
      w.__searchAnimTimer = window.setTimeout(() => root.removeAttribute('data-search-anim'), 1000);
      dialog.classList.remove('open');
      dialog.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      const field = $<HTMLInputElement>('searchInput');
      if (field) { field.blur(); field.tabIndex = -1; }
    };

    document.addEventListener('click', e => {
      const target = e.target as HTMLElement;
      if (target.closest('[data-search-open]')) {
        e.preventDefault();
        open();
        return;
      }
      if (target.closest('[data-search-close]')) {
        close();
        return;
      }
      if (target.id === 'searchDialog') close(); // click on the backdrop
      if (target.closest('#searchResults .search-result')) close(); // navigating away
    });

    document.addEventListener('input', e => {
      if ((e.target as HTMLElement).id === 'searchInput') render((e.target as HTMLInputElement).value);
    });

    document.addEventListener('keydown', e => {
      const typing = /^(INPUT|TEXTAREA|SELECT)$/.test((e.target as HTMLElement)?.tagName) || (e.target as HTMLElement)?.isContentEditable;
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        isOpen() ? close() : open();
        return;
      }
      if (!isOpen()) {
        if (e.key === '/' && !typing && !e.ctrlKey && !e.metaKey && !e.altKey) {
          e.preventDefault();
          open();
        }
        return;
      }
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActive(active + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(active - 1);
      } else if (e.key === 'Enter' && (e.target as HTMLElement).id === 'searchInput' && !(e as KeyboardEvent).isComposing) {
        const links = document.querySelectorAll<HTMLElement>('#searchResults .search-result');
        const link = links[active >= 0 ? active : 0];
        if (link) {
          e.preventDefault();
          link.click();
        }
      }
    });

    /* A page swap replaces <body>: make sure the scroll lock never outlives the dialog. */
    document.addEventListener('astro:before-swap', () => {
      document.documentElement.removeAttribute('data-search');
      document.documentElement.removeAttribute('data-search-anim');
      document.body.style.overflow = '';
    });
  }
</script>
