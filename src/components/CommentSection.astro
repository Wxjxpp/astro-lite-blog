---
import GrokOrb from '@components/GrokOrb.astro';

interface Props {
  term?: string;
}

const { term } = Astro.props;

// Twikoo cloud function URL, e.g. https://my-twikoo.vercel.app
// Deploy it as its own Vercel project (templates/vercel-min) backed by MongoDB Atlas
// so the blog's comments never depend on a GitHub repository.
const envId = import.meta.env.PUBLIC_TWIKOO_ENV_ID;
const isConfigured = Boolean(envId);
---

<section class="comments-section" id="comments">
  <div class="comments-header">
    <h2 class="comments-title">Comments</h2>
    <span class="label">Powered by Twikoo</span>
  </div>

  <div
    class="comments-shell"
    id="commentsShell"
    data-env={envId ? '/api/twikoo' : ''}
    data-path={term || ''}
    data-admin-mode={Astro.url.searchParams.get('twikoo-admin') === '1' ? 'true' : undefined}
  >
    <div class="comments-mascot">
      <GrokOrb size={72} mood="hold" state={isConfigured ? 'loading' : 'curious'} follow={true} />
    </div>
    <div class="comments-stage">
      {
        isConfigured ? (
          <>
            <div id="twikoo" />
            <div class="comments-loader" id="commentsLoader">
              <span class="comments-spinner" aria-hidden="true" />
              <span class="comments-loader-text" id="commentsLoaderText">
                正在加载评论…
              </span>
            </div>
          </>
        ) : (
          <div class="comments-config-hint">
            <p>
              评论功能尚未配置。请在部署时为环境变量 <code>PUBLIC_TWIKOO_ENV_ID</code> 赋值后重新部署：
            </p>
            <p>
              该变量是 Twikoo 云函数的访问地址（形如 <code>https://xxx.vercel.app</code>
              ）。云函数需要单独建一个 Vercel 项目部署（官方 <code>templates/vercel-min</code>），并绑定
              MongoDB Atlas。
            </p>
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  /* Twikoo injects its whole stylesheet as a single <style data-twikoo> in <head>
     when twikoo.min.js is first executed, and never again. <ClientRouter /> swaps
     <head> on every navigation and drops that tag, while window.twikoo (and so the
     script) stays alive: from the second page on the widget renders unstyled and its
     avatars, emoji packs and icons blow up to their natural size.
     Fix: mark the tag as persistent and make sure the incoming head carries a twin so
     Astro keeps the existing node; re-attach it as a last resort. */
  const TK_STYLE_KEY = 'twikoo-style';
  const w = window as any;

  const findTwikooStyle = (): HTMLStyleElement | null =>
    document.head.querySelector<HTMLStyleElement>('style[data-twikoo]');

  const keepTwikooStyle = () => {
    const live = findTwikooStyle();
    if (live) {
      live.setAttribute('data-astro-transition-persist', TK_STYLE_KEY);
      w.__twikooStyle = live;
    } else if (w.__twikooStyle) {
      document.head.appendChild(w.__twikooStyle);
    }
  };

  if (!w.__twikooStyleGuard) {
    w.__twikooStyleGuard = true;
    document.addEventListener('astro:before-swap', event => {
      keepTwikooStyle();
      const saved = w.__twikooStyle as HTMLStyleElement | undefined;
      if (!saved) return;
      const head = (event as any).newDocument?.head as HTMLElement | undefined;
      if (head && !head.querySelector(`[data-astro-transition-persist="${TK_STYLE_KEY}"]`)) {
        head.appendChild(saved.cloneNode(true));
      }
    });
    document.addEventListener('astro:after-swap', keepTwikooStyle);
  }

  // Re-run on every client-side navigation: the comment shell is a fresh element each time.
  const initComments = () => {
    const shell = document.getElementById('commentsShell');
    if (shell && new URLSearchParams(location.search).get('twikoo-admin') === '1') {
      shell.dataset.adminMode = 'true';
    }
    if (shell && shell.dataset.env) {
      // Use the blog's same-origin proxy instead of calling the separate
      // Twikoo deployment directly. This avoids mobile browsers blocking the
      // cross-origin POST with a misleading status 0 error.
      const envId = new URL(shell.dataset.env as string, location.origin).href;
      const path = shell.dataset.path || location.pathname;
      const loader = document.getElementById('commentsLoader');
      const loaderText = document.getElementById('commentsLoaderText');
      const orb = shell.querySelector('[data-grok-orb]') as HTMLElement | null;
      const stage = shell.querySelector('.comments-stage') as HTMLElement | null;

      const setOrb = (next: string) => {
        if (orb) orb.dataset.state = next;
      };
      const orbIs = (...names: string[]) => !!orb && names.includes(orb.dataset.state || '');
      /* Play a one-off reaction, then fall back to idle (unless something else took over). */
      const react = (name: string, ms: number) => {
        setOrb(name);
        window.setTimeout(() => {
          if (orbIs(name)) setOrb('idle');
        }, ms);
      };
      const showLoader = (text?: string) => {
        if (loaderText && text) loaderText.textContent = text;
        loader?.classList.add('visible');
      };
      const hideLoader = () => loader?.classList.remove('visible');

      /* Repeat-click guard: the first click on the send button locks it, and the
         lock is only released once Twikoo has reloaded the comment list (or after
         a safety timeout), so a slow round trip can never post twice. */
      let submitting = false;
      let guardTimer = 0;

      const releaseGuard = () => {
        if (guardTimer) window.clearTimeout(guardTimer);
        guardTimer = 0;
        submitting = false;
        stage
          ?.querySelectorAll('.tk-submitting-guard')
          .forEach(btn => btn.classList.remove('tk-submitting-guard'));
      };

      stage?.addEventListener(
        'click',
        event => {
          const target = event.target as HTMLElement | null;
          const btn = target?.closest('.tk-button--primary');
          if (!btn) return;
          if (submitting) {
            event.preventDefault();
            event.stopPropagation();
            return;
          }
          submitting = true;
          btn.classList.add('tk-submitting-guard');
          setOrb('sending');
          guardTimer = window.setTimeout(() => {
            // Still locked after 15 s: the comment never came back, treat it as a failure.
            if (!submitting) return;
            releaseGuard();
            react('sad', 3000);
          }, 15000);
        },
        true
      );

      stage?.addEventListener('focusin', event => {
        const el = event.target as HTMLElement | null;
        if (!submitting && el?.matches('textarea, input')) setOrb('listening');
      });
      stage?.addEventListener('input', event => {
        const el = event.target as HTMLElement | null;
        if (!submitting && el?.matches('textarea')) setOrb('writing');
      });
      stage?.addEventListener('focusout', () => {
        if (!submitting && orbIs('listening', 'writing')) setOrb('idle');
      });

      const loadTwikoo = () =>
        new Promise<any>((resolve, reject) => {
          const ready = (window as any).twikoo;
          // The widget container has id="twikoo", so browsers expose it as
          // window.twikoo before the client script is loaded. Only reuse the
          // global when it is the actual Twikoo API, not that DOM element.
          if (ready && typeof ready.init === 'function') return resolve(ready);
          const el = document.createElement('script');
          el.src = '/twikoo/twikoo.min.js';
          el.async = true;
          el.onload = () => {
            const api = (window as any).twikoo;
            if (api && typeof api.init === 'function') return resolve(api);
            reject(new Error('[Twikoo] client API failed to initialize'));
          };
          el.onerror = () => reject(new Error('[Twikoo] client failed to load'));
          document.head.appendChild(el);
        });

      // Keep the block from looking broken while the widget boots (the CDN path
      // through Cloudflare can be slow).
      showLoader('正在加载评论…');
      setOrb('loading');

      loadTwikoo()
        .then(twikoo => {
          if (!twikoo || !envId) throw new Error('[Twikoo] client or envId missing');
          keepTwikooStyle();
          return twikoo.init({
            envId,
            el: '#twikoo',
            path,
            lang: 'zh-CN',
            onCommentLoaded: () => {
              // Twikoo reloads the list after a successful send: that is our "sent!" signal.
              const justSent = submitting;
              hideLoader();
              releaseGuard();
              if (justSent) react('celebrate', 3200);
              else react('happy', 1600);
            },
          });
        })
        .then(() => {
          keepTwikooStyle();
          hideLoader();
          releaseGuard();
          if (orbIs('loading')) setOrb('idle');
        })
        .catch(err => {
          console.error(err);
          if (loaderText) loaderText.textContent = '评论加载失败，请刷新重试';
          setOrb('sad');
        });
    }
  };
  document.addEventListener('astro:page-load', initComments);
</script>

</style>
