---
import { NAV_MENU, SITE_CONFIG } from '@lib/utils';
const currentPath = Astro.url.pathname;
// Icons: GitHub Octicons (MIT) — search, x, sun, moon, device-desktop, check.
const I = {"search": "M10.68 11.74a6 6 0 0 1-7.922-8.982 6 6 0 0 1 8.982 7.922l3.04 3.04a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215ZM11.5 7a4.499 4.499 0 1 0-8.997 0A4.499 4.499 0 0 0 11.5 7Z", "x": "M3.72 3.72a.75.75 0 0 1 1.06 0L8 6.94l3.22-3.22a.749.749 0 0 1 1.275.326.749.749 0 0 1-.215.734L9.06 8l3.22 3.22a.749.749 0 0 1-.326 1.275.749.749 0 0 1-.734-.215L8 9.06l-3.22 3.22a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042L6.94 8 3.72 4.78a.75.75 0 0 1 0-1.06Z", "sun": "M8 12a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm0-1.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm5.657-8.157a.75.75 0 0 1 0 1.061l-1.061 1.06a.749.749 0 0 1-1.275-.326.749.749 0 0 1 .215-.734l1.06-1.06a.75.75 0 0 1 1.06 0Zm-9.193 9.193a.75.75 0 0 1 0 1.06l-1.06 1.061a.75.75 0 1 1-1.061-1.06l1.06-1.061a.75.75 0 0 1 1.061 0ZM8 0a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0V.75A.75.75 0 0 1 8 0ZM3 8a.75.75 0 0 1-.75.75H.75a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 3 8Zm13 0a.75.75 0 0 1-.75.75h-1.5a.75.75 0 0 1 0-1.5h1.5A.75.75 0 0 1 16 8Zm-8 5a.75.75 0 0 1 .75.75v1.5a.75.75 0 0 1-1.5 0v-1.5A.75.75 0 0 1 8 13Zm3.536-1.464a.75.75 0 0 1 1.06 0l1.061 1.06a.75.75 0 0 1-1.06 1.061l-1.061-1.06a.75.75 0 0 1 0-1.061ZM2.343 2.343a.75.75 0 0 1 1.061 0l1.06 1.061a.751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018l-1.06-1.06a.75.75 0 0 1 0-1.06Z", "moon": "M9.598 1.591a.749.749 0 0 1 .785-.175 7.001 7.001 0 1 1-8.967 8.967.75.75 0 0 1 .961-.96 5.5 5.5 0 0 0 7.046-7.046.75.75 0 0 1 .175-.786Zm1.616 1.945a7 7 0 0 1-7.678 7.678 5.499 5.499 0 1 0 7.678-7.678Z", "desktop": "M14.25 1c.966 0 1.75.784 1.75 1.75v7.5A1.75 1.75 0 0 1 14.25 12h-3.727c.099 1.041.52 1.872 1.292 2.757A.752.752 0 0 1 11.25 16h-6.5a.75.75 0 0 1-.565-1.243c.772-.885 1.192-1.716 1.292-2.757H1.75A1.75 1.75 0 0 1 0 10.25v-7.5C0 1.784.784 1 1.75 1ZM1.75 2.5a.25.25 0 0 0-.25.25v7.5c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25v-7.5a.25.25 0 0 0-.25-.25ZM9.018 12H6.982a5.72 5.72 0 0 1-.765 2.5h3.566a5.72 5.72 0 0 1-.765-2.5Z", "check": "M13.78 4.22a.75.75 0 0 1 0 1.06l-7.25 7.25a.75.75 0 0 1-1.06 0L2.22 9.28a.751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018L6 10.94l6.72-6.72a.75.75 0 0 1 1.06 0Z"};
const icon = (name: string, size = 18, cls = '') =>
  `<svg class="oi ${cls}" viewBox="0 0 16 16" width="${size}" height="${size}" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="${I[name]}"></path></svg>`;
const THEMES = [
  { pref: 'system', label: '跟随系统', icon: 'desktop' },
  { pref: 'light', label: '亮色', icon: 'sun' },
  { pref: 'dark', label: '暗色', icon: 'moon' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="site-logo">
      <span>{SITE_CONFIG.title}</span>
    </a>
    <nav class="nav-menu" id="navMenu" aria-label="主导航">
      {NAV_MENU.map(item => (
        <a href={item.href} class={`nav-link ${currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) ? 'active' : ''}`}>{item.label}</a>
      ))}
    </nav>
    <div class="header-actions">
      <button class="icon-btn search-btn" type="button" data-search-open aria-label="搜索文章（Ctrl+K）" aria-haspopup="dialog" set:html={icon('search', 18)}></button>

      <div class="theme-switch" id="themeSwitch">
        <button class="icon-btn" id="themeToggle" type="button" aria-label="切换主题" aria-haspopup="menu" aria-expanded="false" aria-controls="themeMenu">
          {THEMES.map(t => <Fragment set:html={icon(t.icon, 18, `ti ti-${t.pref}`)} />)}
        </button>
        <div class="theme-menu" id="themeMenu" role="menu" aria-label="主题">
          {THEMES.map((t, k) => (
            <button type="button" class="theme-item" role="menuitemradio" aria-checked="false" data-pref={t.pref} style={`--k:${k}`}>
              <Fragment set:html={icon(t.icon, 16)} />
              <span>{t.label}</span>
              <Fragment set:html={icon('check', 16, 'tm-check')} />
            </button>
          ))}
        </div>
      </div>

      <button
        class="icon-btn mobile-menu-btn"
        id="mobileMenuBtn"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="navMenu"
      >
        <span class="menu-bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>

    <!-- The bar morphs into this field when search opens (see SearchDialog) -->
    <div class="header-search" role="search">
      <Fragment set:html={icon('search', 18, 'search-field-icon')} />
      <input
        id="searchInput"
        class="search-input"
        type="search"
        inputmode="search"
        enterkeyhint="search"
        placeholder="搜索标题、描述、标签、分类…"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        aria-controls="searchResults"
        tabindex="-1"
      />
      <button class="search-close" type="button" data-search-close aria-label="关闭搜索" set:html={icon('x', 16)}></button>
    </div>
  </div>
</header>
<div class="nav-backdrop" id="navBackdrop" aria-hidden="true"></div>
