---
import { slugify } from '@lib/utils';
interface Props { tag: string; size?: 'sm' | 'md'; link?: boolean; }
const { tag, size = 'sm', link = true } = Astro.props;
const cls = `tag-badge ${size === 'md' ? 'tag-badge-md' : ''}`;
---

{link ? (
  <a href={`/tags/${slugify(tag)}`} class={cls}>#{tag}</a>
) : (
  <span class={cls}>#{tag}</span>
)}