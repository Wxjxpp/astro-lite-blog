---
import { slugify } from '@lib/utils';
interface Props { tag: string; size?: 'sm' | 'md'; }
const { tag, size = 'sm' } = Astro.props;
---

<a href={`/tags/${slugify(tag)}`} class={`tag-badge ${size === 'md' ? 'tag-badge-md' : ''}`}>
  #{tag}
</a>

<style>
  .tag-badge-md { font-size: 0.85rem; padding: 0.25rem 0.6rem; }
</style>
