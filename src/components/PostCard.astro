---
import type { PostItem } from '@types/index';
import { formatDate } from '@lib/utils';
import TagBadge from './TagBadge.astro';

interface Props { post: PostItem; }
const { post } = Astro.props;
const postUrl = `/posts/${post.slug}`;
---

<a href={postUrl} class="post-card">
  <div class="post-card-header">
    <span class="post-card-category">{post.category}</span>
    <time datetime={post.pubDate.toISOString()}>{formatDate(post.pubDate)}</time>
  </div>
  <h2 class="post-card-title">{post.title}</h2>
  <p class="post-card-excerpt">{post.description}</p>
  <div class="post-card-footer">
    <div class="post-card-tags">
      {post.tags.slice(0, 3).map(tag => (<TagBadge tag={tag} />))}
    </div>
    <div class="post-card-meta">
      <span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:inline;vertical-align:middle;margin-right:2px;"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        {post.readingTime} 分钟
      </span>
    </div>
  </div>
</a>
