---
import type { PostItem } from '@types/index';
import PostCard from './PostCard.astro';
import Pagination from './Pagination.astro';

interface Props {
  posts: PostItem[];
  page: number;
  totalPages: number;
  baseUrl: string;
  emptyMessage?: string;
}
const { posts, page, totalPages, baseUrl, emptyMessage = '暂无文章' } = Astro.props;
---

{posts.length > 0 ? (
  <>
    <div class="posts-list">{posts.map(post => (<PostCard post={post} />))}</div>
    <Pagination page={page} totalPages={totalPages} baseUrl={baseUrl} />
  </>
) : (
  <div class="empty-state">{emptyMessage}</div>
)}