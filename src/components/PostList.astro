---
import type { PostItem } from '@types/index';
import PostCard from './PostCard.astro';
import Pagination from './Pagination.astro';

interface Props {
  posts: PostItem[];
  page: number;
  totalPages: number;
  baseUrl: string;
  emptyMessage?: string;
}
const { posts, page, totalPages, baseUrl, emptyMessage = '暂无文章' } = Astro.props;
---

{posts.length > 0 ? (
  <>
    <div class="posts-list">{posts.map(post => (<PostCard post={post} />))}</div>
    <Pagination page={page} totalPages={totalPages} baseUrl={baseUrl} />
  </>
) : (
  <div class="no-comments">
    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin: 0 auto 1rem; opacity: 0.5;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
    <p>{emptyMessage}</p>
  </div>
)}
