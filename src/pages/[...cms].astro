---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getAdminPath, isAdminAuthenticated } from '@lib/admin-auth';

const requestedPath = Array.isArray(Astro.params.cms) ? Astro.params.cms.join('/') : (Astro.params.cms || '');
if (requestedPath !== getAdminPath()) return new Response('Not Found', { status: 404 });
const loggedIn = isAdminAuthenticated(Astro.request);
Astro.response.status = 200;
---
<BaseLayout title="博客管理" description="博客内容管理后台">
  <main class="container-narrow cms-page">
    {loggedIn ? (
      <>
        <header class="cms-header"><div><p class="label">CONTENT STUDIO</p><h1>文章管理</h1><p class="cms-hint">先写正文，保存时系统会告诉你具体缺哪个字段。</p></div><a href="/api/auth/logout">退出登录</a></header>
        <section class="cms-grid">
          <aside class="cms-list"><button id="newPost" class="cms-button primary">＋ 新建文章</button><div id="postList">正在加载…</div></aside>
          <section class="cms-editor">
            <form id="postForm" novalidate>
              <input type="hidden" id="originalSlug" />
              <label>标题 <span class="required-mark">必填</span><input id="title" required /></label>
              <div class="cms-two"><label>Slug <span class="required-mark">必填，仅限英文、数字和连字符</span><input id="slug" required pattern="[a-z0-9-]+" /></label><label>分类 <span class="required-mark">必填</span><input id="category" required /></label></div>
              <label>摘要 <span class="required-mark">必填</span><textarea id="description" rows="2" required></textarea></label>
              <div class="cms-two"><label>发布日期 <span class="required-mark">必填</span><input id="pubDate" type="date" required /></label><label>作者<input id="author" /></label></div>
              <label>封面 URL<input id="cover" type="url" placeholder="https://…" /></label>
              <label>标签（逗号分隔）<input id="tags" placeholder="Astro, 教程" /></label>
              <label>正文 Markdown <span class="required-mark">必填</span><textarea id="content" rows="18" required placeholder="在这里写 Markdown 正文…"></textarea></label>
              <div class="cms-upload"><div><strong>插入图片</strong><small>支持 JPG、PNG、WebP、AVIF；超过 4MB 自动压缩。SVG、GIF 不压缩，需 ≤4MB</small></div><input id="imageUpload" type="file" accept="image/jpeg,image/png,image/gif,image/webp,image/avif,image/svg+xml" /><button class="cms-button" type="button" id="uploadButton">上传并插入正文</button></div>
              <label class="cms-check"><input id="draft" type="checkbox" /> 保存为草稿</label>
              <div class="cms-actions"><button class="cms-button primary" type="submit" id="saveButton">保存文章</button><button class="cms-button" type="button" id="previewButton">预览</button><button class="cms-button danger" type="button" id="deleteButton">删除</button></div>
              <p id="status" class="cms-status" role="status"></p>
            </form>
            <article id="preview" class="markdown-content cms-preview" hidden></article>
          </section>
        </section>
      </>
    ) : (
      <section class="cms-login"><p class="label">PRIVATE CONTENT STUDIO</p><h1>博客管理</h1><p>管理入口不是安全边界，登录仍需 GitHub OAuth 和账号白名单。</p><a class="cms-button primary" href="/api/auth/github">使用 GitHub 登录</a></section>
    )}
  </main>
</BaseLayout>

{loggedIn && <script>
  import { marked } from 'marked';
  const $ = (id) => document.getElementById(id);
  const fields = ['title','slug','description','pubDate','author','cover','tags','content','draft'];
  const labels = { title:'标题', slug:'Slug', description:'摘要', pubDate:'发布日期', category:'分类', content:'正文' };
  const UPLOAD_LIMIT = 4 * 1024 * 1024;
  let current = null;
  const status = (text, error = false) => { const el = $('status'); el.textContent = text; el.classList.toggle('error', error); };
  const mb = (bytes) => (bytes / 1024 / 1024).toFixed(1) + 'MB';
  const readJson = async (response) => { const text = await response.text(); try { return text ? JSON.parse(text) : {}; } catch { return { error: `服务器返回 ${response.status}，不是有效的 JSON 响应` }; } };
  const setBusy = (busy) => { $('saveButton').disabled = busy; $('uploadButton').disabled = busy; };
  // 超过 4MB 的位图在前端自动压缩：逐步降低质量并缩小尺寸，输出 WebP，直到小于上限
  const compressImage = async (file) => {
    const bitmap = await createImageBitmap(file);
    let { width, height } = bitmap;
    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    for (let attempt = 0; attempt < 12; attempt++) {
      canvas.width = width;
      canvas.height = height;
      ctx.drawImage(bitmap, 0, 0, width, height);
      const quality = Math.max(0.4, 0.92 - attempt * 0.05);
      const blob = await new Promise(resolve => canvas.toBlob(resolve, 'image/webp', quality));
      if (blob && blob.size <= UPLOAD_LIMIT) {
        const name = file.name.replace(/\.[^.]+$/, '') + '.webp';
        return new File([blob], name, { type: 'image/webp' });
      }
      width = Math.max(1, Math.round(width * 0.85));
      height = Math.max(1, Math.round(height * 0.85));
    }
    return null;
  };
  const fill = (post = {}) => { current = post.slug || null; fields.forEach(k => { const el = $(k); if (!el) return; if (k === 'tags') el.value = (post.tags || []).join(', '); else if (k === 'draft') el.checked = Boolean(post.draft); else if (k === 'pubDate') el.value = post.pubDate ? new Date(post.pubDate).toISOString().slice(0,10) : new Date().toISOString().slice(0,10); else el.value = post[k] || ''; }); $('originalSlug').value = current || ''; $('preview').hidden = true; status(current ? `正在编辑：${post.title || current}` : '准备新文章'); };
  const load = async () => { const r = await fetch('/api/admin/posts'); const data = await readJson(r); if (!r.ok) return status(data.error || '加载失败', true); $('postList').innerHTML = data.length ? data.map(p => `<button class="cms-post" data-slug="${p.slug}"><strong>${p.title}</strong><small>${p.draft ? '草稿' : '已发布'} · ${p.source === 'file' ? 'Markdown' : '数据库'} · ${p.slug}</small></button>`).join('') : '<p>还没有文章。</p>'; document.querySelectorAll('.cms-post').forEach(b => b.onclick = async () => { const r = await fetch('/api/admin/posts/' + encodeURIComponent(b.dataset.slug)); const post = await readJson(r); r.ok ? fill(post) : status(post.error || '文章加载失败', true); }); };
  const validate = () => { const missing = Object.keys(labels).filter(k => { const el = $(k); return !el || !String(el.value || '').trim(); }); document.querySelectorAll('[required]').forEach(el => el.classList.remove('invalid')); missing.forEach(k => $(k)?.classList.add('invalid')); if (missing.length) { status(`还差：${missing.map(k => labels[k]).join('、')}`, true); $(missing[0])?.focus(); return false; } if (!/^[a-z0-9-]+$/.test($('slug').value.trim())) { $('slug').classList.add('invalid'); status('Slug 只能使用小写英文、数字和连字符，例如 astro-vercel-tutorial', true); $('slug').focus(); return false; } return true; };
  $('newPost').onclick = () => fill();
  $('postForm').onsubmit = async e => { e.preventDefault(); if (!validate()) return; setBusy(true); const body = { title:$('title').value.trim(), slug:$('slug').value.trim(), description:$('description').value.trim(), pubDate:$('pubDate').value, author:$('author').value.trim(), cover:$('cover').value.trim(), category:$('category').value.trim(), tags:$('tags').value.split(',').map(x=>x.trim()).filter(Boolean), content:$('content').value, draft:$('draft').checked }; try { const r = await fetch('/api/admin/posts', { method:'POST', headers:{'content-type':'application/json'}, body:JSON.stringify(body) }); const data = await readJson(r); status(r.ok ? '保存成功，文章已写入存储' : (data.error || '保存失败'), !r.ok); if(r.ok){ current=data.slug; await load(); } } finally { setBusy(false); } };
  $('uploadButton').onclick = async () => {
    let file = $('imageUpload').files?.[0];
    if (!file) return status('请先选择一张图片', true);
    if (file.size > UPLOAD_LIMIT) {
      if (file.type === 'image/svg+xml' || file.type === 'image/gif') return status(`图片 ${mb(file.size)} 超过 4MB，SVG/GIF 无法自动压缩，请手动压缩后再上传`, true);
      setBusy(true);
      status(`图片 ${mb(file.size)} 超过 4MB，正在自动压缩…`);
      try {
        file = await compressImage(file);
      } catch { file = null; }
      setBusy(false);
      if (!file) return status('自动压缩后仍超过 4MB，请手动压缩后再上传', true);
    }
    const originalSize = $('imageUpload').files?.[0]?.size;
    const form = new FormData();
    form.append('file', file);
    setBusy(true);
    status(originalSize && originalSize > UPLOAD_LIMIT ? `已自动压缩：${mb(originalSize)} → ${mb(file.size)}，正在上传…` : '正在上传图片…');
    try { const r = await fetch('/api/admin/upload', { method:'POST', body:form }); const data = await readJson(r); if (!r.ok) return status(data.error || '图片上传失败', true); const area = $('content'); const markdown = `\n\n${data.markdown}\n`; area.setRangeText(markdown, area.selectionStart, area.selectionEnd, 'end'); status(originalSize && originalSize > UPLOAD_LIMIT ? `图片上传成功（已自动压缩 ${mb(originalSize)} → ${mb(file.size)}），Markdown 已插入正文` : '图片上传成功，Markdown 已插入正文'); $('imageUpload').value = ''; } finally { setBusy(false); }
  };
  $('previewButton').onclick = () => { $('preview').innerHTML = marked.parse($('content').value); $('preview').hidden = false; };
  $('deleteButton').onclick = async () => { if(!current || !confirm('确认隐藏这篇文章？原内容会保留，可恢复。')) return; const r=await fetch('/api/admin/posts/'+encodeURIComponent(current),{method:'DELETE',headers:{'content-type':'application/json'}}); const data = await readJson(r); status(r.ok ? '删除成功，文章已隐藏' : (data.error || '删除失败'), !r.ok); if(r.ok){fill();load();} };
  fill(); load();
</script>}

<style>
  .cms-page { padding-block: var(--space-3xl); } .cms-hint,.required-mark,.cms-upload small { color:var(--fg-muted); font-size:.8rem; } .cms-header,.cms-grid,.cms-two,.cms-actions { display:grid; gap:1rem; } .cms-header { grid-template-columns:1fr auto; align-items:end; border-bottom:1px solid var(--border); padding-bottom:1rem; } .cms-grid { grid-template-columns:240px 1fr; margin-top:2rem; } .cms-list { display:flex; flex-direction:column; gap:1rem; } .cms-post { text-align:left; background:transparent; border:1px solid var(--border); padding:.8rem; cursor:pointer; } .cms-post small { display:block; margin-top:.4rem; opacity:.65; } .cms-editor form { display:grid; gap:1rem; } .cms-editor label { display:grid; gap:.35rem; } .cms-editor input,.cms-editor textarea { width:100%; box-sizing:border-box; border:1px solid var(--border); background:transparent; padding:.7rem; font:inherit; color:inherit; border-radius:.5rem; } .cms-editor input.invalid,.cms-editor textarea.invalid { border-color:#d33; box-shadow:0 0 0 2px color-mix(in srgb,#d33 18%,transparent); } .cms-two { grid-template-columns:1fr 1fr; } .cms-actions { grid-template-columns:repeat(3,auto); justify-content:start; } .cms-button { border:1px solid var(--border); background:transparent; color:inherit; padding:.7rem 1rem; cursor:pointer; text-decoration:none; border-radius:.65rem; } .cms-button:disabled { opacity:.5; cursor:wait; } .cms-button.primary { background:var(--fg); color:var(--bg); } .cms-button.danger { color:#d33; } .cms-status { min-height:1.2em; color:var(--fg-muted); } .cms-status.error { color:#d33; } .cms-preview { border-top:1px solid var(--border); margin-top:2rem; padding-top:2rem; } .cms-upload { display:grid; grid-template-columns:1fr auto auto; align-items:center; gap:.75rem; padding:1rem; border:1px dashed var(--border-strong); border-radius:.75rem; } .cms-upload small { display:block; margin-top:.25rem; } .cms-upload input { border:0; padding:0; } .cms-login { max-width:34rem; margin:8rem auto; } .cms-login p { margin-block:1rem; } @media(max-width:700px){ .cms-grid,.cms-two { grid-template-columns:1fr; } .cms-header { grid-template-columns:1fr; } .cms-upload { grid-template-columns:1fr; } .cms-actions { grid-template-columns:1fr; } }
</style>
