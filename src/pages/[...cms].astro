    const svg = (name: string, size = 18) =>
      `<svg class="oi" viewBox="0 0 16 16" width="${size}" height="${size}" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="${ICONS[name]}"/></svg>`;

    /* ------------------------------------------------ tool + template definitions */
    // Plain-text headings: the coloured boxes carry no emoji so they look the same everywhere.
    const callout = (name: string, bg: string, bar: string, ink: string, text: string) =>
      `<div style="background:${bg};border-left:4px solid ${bar};color:#1f2937;padding:12px 16px;border-radius:8px;margin:16px 0;">\n<strong style="color:${ink};">${name}</strong>\n<div>${text}</div>\n</div>`;

    const cycleHeading = () => {
      const v = content.value, s = content.selectionStart;
      const ls = v.lastIndexOf('\n', s - 1) + 1;
      const le = v.indexOf('\n', s) === -1 ? v.length : v.indexOf('\n', s);
      const line = v.slice(ls, le);
      const m = line.match(/^(#{1,6})\s+/);
      const level = m ? m[1].length : 1; // none -> ##, ## -> ###, … , ###### -> plain text
      const text = m ? line.slice(m[0].length) : (line || '标题');
      const next = !m ? '## ' : level >= 6 ? '' : '#'.repeat(level + 1) + ' ';
      const out = next + text;
      replaceRange(ls, le, out, out.length, out.length);
    };
    const codeBlock = () => insertBlock('```js\n// 在这里写代码\n```', '// 在这里写代码');

    // Order follows GitHub's mobile editor: B / I / link / image / lists / task / H / S / code / undo
    const TOOLS = [
      { k: 'bold', t: '加粗 (Ctrl+B)', run: () => wrap('**', '**', '加粗文字') },
      { k: 'italic', t: '斜体 (Ctrl+I)', run: () => wrap('*', '*', '斜体文字') },
      { k: 'link', t: '链接', run: () => wrap('[', '](https://)', '链接文字') },
      { k: 'image', t: '上传并插入图片', run: () => $('imageUpload').click(), noDirty: true },
      { k: 'ul', t: '无序列表', run: () => prefixLines('- ', '列表项') },
      { k: 'ol', t: '有序列表', run: () => prefixLines('1. ', '列表项') },
      { k: 'task', t: '任务列表', run: () => prefixLines('- [ ] ', '待办') },
      { k: 'heading', t: '标题（再点一次升一级）', run: cycleHeading },
      { k: 'strike', t: '删除线', run: () => wrap('~~', '~~', '删除线') },
      { k: 'quote', t: '引用', run: () => prefixLines('> ', '引用内容') },
      { k: 'code', t: '行内代码', run: () => wrap('`', '`', 'code') },
      { k: 'codeblock', t: '代码块', run: codeBlock },
      { k: 'hr', t: '分隔线', run: () => insertBlock('---') },
      { k: 'undo', t: '撤销', run: () => { content.focus(); document.execCommand('undo'); } },
      { k: 'redo', t: '重做', run: () => { content.focus(); document.execCommand('redo'); } },
    ];

    const footnote = () => {
      const n = (content.value.match(/\[\^\d+\]:/g) || []).length + 1;
      wrap(`[^${n}]`, '', '');
      const end = content.value.length;
      const sep = content.value.endsWith('\n') ? '\n' : '\n\n';
      const pre = `${sep}[^${n}]: `;
      replaceRange(end, end, pre + '脚注内容', pre.length, pre.length + 4);
    };
    const TEMPLATES = [
      { k: 'doc', l: '文章骨架', run: () => insertBlock('## 引言\n\n用一两段话说明这篇文章要解决什么问题。\n\n## 正文\n\n### 第一部分\n\n内容……\n\n### 第二部分\n\n内容……\n\n## 总结\n\n- 要点一\n- 要点二\n- 要点三', '用一两段话说明这篇文章要解决什么问题。') },
      { k: 'steps', l: '教程步骤', run: () => insertBlock('## 准备工作\n\n- 环境要求：……\n\n## 步骤\n\n### 1. 第一步\n\n说明……\n\n```bash\nnpm install\n```\n\n### 2. 第二步\n\n说明……\n\n## 常见问题\n\n**Q：……？**\n\nA：……', '说明……') },
      { k: 'table', l: '表格', run: () => insertBlock('| 名称 | 说明 | 备注 |\n| --- | --- | --- |\n| 项目一 | 内容 | — |\n| 项目二 | 内容 | — |', '名称') },
      { k: 'compare', l: '对比表', run: () => insertBlock('| 对比项 | 方案 A | 方案 B |\n| --- | --- | --- |\n| 优点 | …… | …… |\n| 缺点 | …… | …… |\n| 适用场景 | …… | …… |', '方案 A') },
      { k: 'tip', l: '提示框', run: () => insertBlock(callout('提示', '#eff6ff', '#3b82f6', '#1d4ed8', '这是一条提示信息。'), '这是一条提示信息。') },
      { k: 'ok', l: '成功框', run: () => insertBlock(callout('成功', '#f0fdf4', '#22c55e', '#15803d', '操作已成功完成。'), '操作已成功完成。') },
      { k: 'warn', l: '警告框', run: () => insertBlock(callout('警告', '#fffbeb', '#f59e0b', '#b45309', '请注意以下事项。'), '请注意以下事项。') },
      { k: 'err', l: '错误框', run: () => insertBlock(callout('错误', '#fef2f2', '#ef4444', '#b91c1c', '发生了一个错误。'), '发生了一个错误。') },
      { k: 'fold', l: '折叠块', run: () => insertBlock('<details>\n<summary>点击展开</summary>\n\n折叠的内容……\n\n</details>', '折叠的内容……') },
      { k: 'sigma', l: '行内公式', run: () => wrap('$', '$', 'E = mc^2') },
      { k: 'sigma', l: '块级公式', run: () => insertBlock('$$\nx = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}\n$$', 'x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}') },
      { k: 'foot', l: '脚注', run: footnote },
      { k: 'kbd', l: '按键', run: () => insertBlock('<kbd>Ctrl</kbd> + <kbd>S</kbd>', 'Ctrl') },
    ];

    /* ------------------------------------------------ build the tool panel */
    const scroll = $('toolsScroll');
    const sheet = $('tplSheet');
    const closeSheet = () => { sheet.hidden = true; tplChip.classList.remove('is-on'); };
    const makeBtn = (item: any, cls = '') => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'cms-tool ' + cls;
      b.innerHTML = svg(item.k) + (item.l ? `<span>${item.l}</span>` : '');
      if (item.t || item.l) { b.title = item.t || item.l; b.setAttribute('aria-label', item.t || item.l); }
      b.addEventListener('click', () => { item.run(); if (!item.noDirty) setDirty(true); countWords(); closeSheet(); });
      return b;
    };
    const section = (title: string, cls: string) => {
      const sec = document.createElement('section');
      sec.className = 'cms-tool-group ' + cls;
      sec.innerHTML = `<h3>${title}</h3><div class="cms-tool-row"></div>`;
      scroll.appendChild(sec);
      return sec.querySelector('.cms-tool-row') as HTMLElement;
    };
    const fmtRow = section('格式', 'is-format');
    TOOLS.forEach(t => fmtRow.appendChild(makeBtn(t)));
    // desktop: templates listed in the side panel
    const tplRow = section('模板', 'is-templates');
    TEMPLATES.forEach(t => tplRow.appendChild(makeBtn(t, 'tpl')));
    // mobile: a chip at the end of the bar opens the templates sheet above it
    const tplChip = document.createElement('button');
    tplChip.type = 'button';
    tplChip.className = 'cms-tool chip-tpl';
    tplChip.innerHTML = svg('tpl') + '<span>模板</span>';
    tplChip.addEventListener('click', () => {
      if (sheet.hidden) {
        sheet.innerHTML = '';
        TEMPLATES.forEach(t => sheet.appendChild(makeBtn(t, 'tpl')));
        sheet.hidden = false; tplChip.classList.add('is-on');
      } else closeSheet();
    });
    fmtRow.appendChild(tplChip);

    // keep the textarea focused (and the keyboard open) while tapping tools
    $('mdTools').addEventListener('pointerdown', e => { if ((e.target as HTMLElement).closest('button')) e.preventDefault(); });

    /* ------------------------------------------------ mobile: bar floats above the keyboard and hides with it */
    const vv = window.visualViewport;
    let dockWanted = false;                       // the textarea has focus (and we're editing, not previewing)
    let baseH = vv ? vv.height : window.innerHeight; // viewport height with no keyboard
    const typing = () => /^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement?.tagName || '');
    function refreshDock() {
      const tools = $('mdTools');
      const kbOpen = vv ? baseH - vv.height > 120 : true;
      const show = !desktop.matches && dockWanted && kbOpen;
      document.documentElement.classList.toggle('cms-kb', show);
      if (!show) closeSheet();
      if (show && vv) tools.style.setProperty('--kb', Math.max(0, window.innerHeight - vv.height - vv.offsetTop) + 'px');
      else tools.style.removeProperty('--kb');
    }
    function setDock(on: boolean) { dockWanted = on; refreshDock(); }
    const onViewport = () => {
      if (vv) baseH = typing() ? Math.max(baseH, vv.height) : vv.height; // only re-measure while no field is focused
      refreshDock();
    };
    content.addEventListener('focus', () => setDock(true));
    content.addEventListener('blur', () => setTimeout(() => { if (document.activeElement !== content) setDock(false); }, 120));
    vv?.addEventListener('resize', onViewport);
    vv?.addEventListener('scroll', refreshDock);
    window.addEventListener('orientationchange', () => setTimeout(onViewport, 300));
    desktop.addEventListener('change', () => { $('listBox').open = desktop.matches; setDock(false); });

    /* ------------------------------------------------ Blob library: scan 3 at a time, insert / delete */
    let blobMode = 'recent';
    let blobOffset = 0;
    let blobBusy = false;
    const blobList = $('blobList');
    const fmtSize = (b: number) => (b >= 1048576 ? (b / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(b / 1024)) + ' KB');
    const fmtDate = (v: string) => new Date(v).toLocaleString('zh-CN', { hour12: false, month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    const blobAlt = (pathname: string) => (pathname.split('/').pop() || 'image').replace(/\.[^.]+$/, '').replace(/-[A-Za-z0-9]{20,}$/, '') || 'image';

    const renderBlob = (item: any) => {
      const row = document.createElement('div');
      row.className = 'cms-blob';
      row.dataset.url = item.url;
      const thumb = document.createElement('div');
      thumb.className = 'cms-blob-thumb';
      const loadThumb = () => { thumb.innerHTML = ''; const img = document.createElement('img'); img.src = item.url; img.alt = ''; img.loading = 'lazy'; thumb.appendChild(img); };
      if (blobMode === 'recent') loadThumb();
      else {
        const b = document.createElement('button');
        b.type = 'button'; b.textContent = '预览'; b.className = 'cms-btn';
        b.onclick = loadThumb;
        thumb.appendChild(b);
      }
      const info = document.createElement('div');
      info.className = 'cms-blob-info';
      const name = document.createElement('strong');
      name.textContent = item.pathname;
      const meta = document.createElement('small');
      meta.innerHTML = `<b class="${item.used ? 'pub' : 'draft'}">${item.used ? '使用中' : '未使用'}</b> · ${fmtSize(item.size)} · ${fmtDate(item.uploadedAt)}`;
      const link = document.createElement('code');
      link.textContent = item.url;
      info.append(name, meta, link);
      const acts = document.createElement('div');
      acts.className = 'cms-blob-acts';
      const mk = (label: string, cls: string, fn: () => void) => { const b = document.createElement('button'); b.type = 'button'; b.className = 'cms-btn ' + cls; b.textContent = label; b.onclick = fn; return b; };
      acts.append(
        mk('插入', 'primary', () => { showTab('edit'); insertBlock(`![${blobAlt(item.pathname)}](${item.url})`); setDirty(true); countWords(); status('已把图片插入到光标处'); }),
        mk('复制链接', '', async () => { try { await navigator.clipboard.writeText(item.url); status('链接已复制'); } catch { status('复制失败，请长按链接手动复制', true); } }),
        mk('删除', 'danger', () => deleteBlob(item, row)),
      );
      row.append(thumb, info, acts);
      blobList.appendChild(row);
    };

    const deleteBlob = async (item: any, row: HTMLElement, force = false) => {
      if (!force && !confirm(`永久删除这张图片？\n${item.pathname}\n此操作无法恢复。`)) return;
      const r = await fetch('/api/admin/blobs', { method: 'DELETE', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ url: item.url, force }) });
      const data = await readJson(r);
      if (r.status === 409 && data.used) {
        if (confirm(`${data.error}。\n仍要强制删除吗？`)) return deleteBlob(item, row, true);
        return;
      }
      if (!r.ok) return status(data.error || '删除失败', true);
      row.remove();
      blobOffset = Math.max(0, blobOffset - 1); // the next page starts one earlier now that this row is gone
      status('图片已从 Blob 永久删除');
    };

    const scanBlobs = async (reset: boolean) => {
      if (blobBusy) return;
      blobBusy = true;
      const scanBtn = $('blobScan') as HTMLButtonElement, moreBtn = $('blobMore') as HTMLButtonElement;
      scanBtn.disabled = moreBtn.disabled = true;
      if (reset) { blobOffset = 0; blobList.innerHTML = ''; }
      status('正在扫描图片…');
      try {
        const r = await fetch(`/api/admin/blobs?limit=3&offset=${blobOffset}&unused=${blobMode === 'unused' ? 1 : 0}`);
        const data = await readJson(r);
        if (!r.ok) return status(data.error || '扫描失败', true);
        data.items.forEach(renderBlob);
        blobOffset = data.nextOffset;
        moreBtn.hidden = !data.hasMore;
        scanBtn.textContent = '重新扫描';
        if (!blobList.children.length) blobList.innerHTML = `<p class="cms-empty">${blobMode === 'unused' ? '没有未使用的图片' : 'Blob 里还没有图片'}。</p>`;
        $('blobTip').textContent = `存储中共 ${data.storeTotal} 张，其中未使用 ${data.unusedTotal} 张；当前列表已显示 ${blobList.querySelectorAll('.cms-blob').length}/${data.total} 张。`;
        status(`已扫描 ${data.items.length} 张图片`);
      } finally { blobBusy = false; scanBtn.disabled = moreBtn.disabled = false; }
    };
    $('blobScan').addEventListener('click', () => scanBlobs(true));
    $('blobMore').addEventListener('click', () => scanBlobs(false));
    document.querySelectorAll<HTMLButtonElement>('.cms-seg button').forEach(b => b.addEventListener('click', () => {
      blobMode = b.dataset.mode || 'recent';
      document.querySelectorAll('.cms-seg button').forEach(x => x.classList.toggle('is-on', x === b));
      blobList.innerHTML = '';
      $('blobMore').hidden = true;
      $('blobScan').textContent = '扫描 3 张';
      $('blobTip').textContent = blobMode === 'unused'
        ? '只列出没被任何文章引用的图片链接；点“预览”才会加载单张图片。'
        : '不会自动扫描。每次只取 3 张，只加载这 3 张的缩略图，节省流量。';
    }));

    /* ------------------------------------------------ misc UX */
    $('postForm').addEventListener('input', () => setDirty(true));
    content.addEventListener('input', countWords);
    window.addEventListener('beforeunload', e => { if (dirty) { e.preventDefault(); e.returnValue = ''; } });
    document.addEventListener('keydown', e => {
      const mod = e.ctrlKey || e.metaKey;
      if (!mod) return;
      const k = e.key.toLowerCase();
      if (k === 's') { e.preventDefault(); $('postForm').requestSubmit(); }
      else if (k === 'b' && document.activeElement === content) { e.preventDefault(); TOOLS[0].run(); }
      else if (k === 'i' && document.activeElement === content) { e.preventDefault(); TOOLS[1].run(); }
    });

    $('listBox').open = desktop.matches;
    fill();
    load();
  }
</script>

<style is:global>
  .cms-page { max-width: 1320px; margin: 0 auto; padding: 1rem 1rem 6rem; font-size: 16px; line-height: 1.6; }
  .cms-page * { box-sizing: border-box; }

  /* top bar */
  .cms-bar { position: sticky; top: 0; z-index: 30; display: flex; align-items: center; justify-content: space-between; gap: 0.75rem;
    padding: 0.6rem 0.9rem; margin-bottom: 0.5rem; background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid var(--border); border-radius: 0.9rem; }
  .cms-bar-title { display: flex; align-items: center; gap: 0.5rem; font-size: 1.1rem; }
  .cms-bar-actions { display: flex; gap: 0.5rem; }
  .cms-dot { width: 0.6rem; height: 0.6rem; border-radius: 50%; background: #f59e0b; }
  .cms-status { min-height: 1.6rem; margin: 0 0.25rem 0.75rem; font-size: 0.92rem; color: var(--fg-muted); }
  .cms-status.error { color: #dc2626; font-weight: 600; }

  /* buttons */
  .cms-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 2.5rem; padding: 0 1rem; font: inherit; font-size: 0.95rem;
    color: inherit; background: transparent; border: 1px solid var(--border-strong, var(--border)); border-radius: 0.7rem; cursor: pointer; text-decoration: none; white-space: nowrap; }
  .cms-btn:hover { background: color-mix(in srgb, var(--fg) 7%, transparent); }
  .cms-btn.primary { background: var(--fg); color: var(--bg); border-color: var(--fg); font-weight: 600; }
  .cms-btn.danger { color: #dc2626; border-color: color-mix(in srgb, #dc2626 45%, var(--border)); }
  .cms-btn.ghost { border-color: transparent; color: var(--fg-muted); }
  .cms-btn:disabled { opacity: 0.5; cursor: wait; }

  /* layout: list | editor | tools */
  .cms-layout { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem; align-items: start; }
  @media (min-width: 1024px) {
    .cms-layout { grid-template-columns: 250px minmax(0, 1fr) 270px; }
    .cms-list, .cms-tools { position: sticky; top: 4.6rem; max-height: calc(100vh - 5.6rem); overflow-y: auto; }
  }

  /* list */
  .cms-list { border: 1px solid var(--border); border-radius: 1rem; padding: 0.35rem; }
  .cms-list > summary { display: flex; justify-content: space-between; align-items: center; padding: 0.7rem 0.8rem; font-weight: 600; cursor: pointer; list-style: none; }
  .cms-list > summary::-webkit-details-marker { display: none; }
  .cms-count { font-size: 0.8rem; color: var(--fg-muted); border: 1px solid var(--border); border-radius: 99px; padding: 0 0.55rem; }
  @media (min-width: 1024px) { .cms-list > summary { cursor: default; pointer-events: none; } }
  .cms-filter { width: calc(100% - 0.7rem); margin: 0 0.35rem 0.5rem; padding: 0.6rem 0.75rem; font: inherit; font-size: 0.92rem; color: inherit; background: transparent; border: 1px solid var(--border); border-radius: 0.65rem; }
  .cms-posts { display: flex; flex-direction: column; gap: 0.25rem; padding: 0 0.35rem 0.35rem; }
  .cms-post { display: block; width: 100%; text-align: left; padding: 0.65rem 0.75rem; font: inherit; color: inherit; background: transparent; border: 1px solid transparent; border-radius: 0.7rem; cursor: pointer; }
  .cms-post:hover { background: color-mix(in srgb, var(--fg) 6%, transparent); }
  .cms-post.is-on { border-color: var(--fg); background: color-mix(in srgb, var(--fg) 8%, transparent); }
  .cms-post strong { display: block; font-size: 0.95rem; line-height: 1.35; }
  .cms-post small { display: flex; gap: 0.5rem; align-items: center; margin-top: 0.25rem; font-size: 0.75rem; color: var(--fg-muted); }
  .cms-post small b { font-weight: 600; } .cms-post small b.draft { color: #d97706; } .cms-post small b.pub { color: #16a34a; }
  .cms-empty { padding: 0.75rem; color: var(--fg-muted); font-size: 0.9rem; }

  /* editor cards + fields */
  .cms-editor form { display: grid; gap: 1rem; }
  .cms-card { border: 1px solid var(--border); border-radius: 1rem; padding: 1rem; background: color-mix(in srgb, var(--bg) 92%, var(--fg) 3%); }
  .cms-field { display: grid; gap: 0.4rem; }
  .cms-label { font-size: 0.9rem; font-weight: 600; }
  .cms-label em { font-style: normal; font-weight: 400; font-size: 0.78rem; color: var(--fg-muted); margin-left: 0.35rem; }
  .cms-editor input:not([type='checkbox']), .cms-editor textarea { width: 100%; padding: 0.7rem 0.85rem; font: inherit; font-size: 1rem; color: inherit;
    background: var(--bg); border: 1px solid var(--border-strong, var(--border)); border-radius: 0.7rem; }
  .cms-editor input:focus, .cms-editor textarea:focus { outline: 2px solid color-mix(in srgb, var(--fg) 55%, transparent); outline-offset: 1px; }
  .cms-editor .invalid { border-color: #dc2626 !important; box-shadow: 0 0 0 3px color-mix(in srgb, #dc2626 18%, transparent); }
  .cms-title-field input { font-size: 1.35rem; font-weight: 700; padding: 0.8rem 0.9rem; }
  .cms-meta { margin-top: 0.9rem; border-top: 1px solid var(--border); padding-top: 0.6rem; }
  .cms-meta > summary { cursor: pointer; padding: 0.4rem 0; font-size: 0.9rem; color: var(--fg-muted); }
  .cms-meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; margin-top: 0.6rem; }
  .cms-wide { grid-column: 1 / -1; }
  .cms-checks { display: flex; gap: 1.4rem; flex-wrap: wrap; }
  .cms-check { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.25rem; cursor: pointer; }
  .cms-check input { width: 1.15rem; height: 1.15rem; }
  @media (max-width: 640px) { .cms-meta-grid { grid-template-columns: 1fr; } }

  /* body: tabs + textarea */
  .cms-body-card { padding: 0.6rem 0.8rem 0.9rem; }
  .cms-tabs { display: flex; align-items: center; gap: 0.25rem; margin-bottom: 0.6rem; }
  .cms-tab { min-height: 2.3rem; padding: 0 1rem; font: inherit; font-size: 0.92rem; color: var(--fg-muted); background: transparent; border: 0; border-bottom: 2px solid transparent; cursor: pointer; }
  .cms-tab.is-on { color: var(--fg); font-weight: 600; border-bottom-color: var(--fg); }
  .cms-wc { margin-left: auto; font-size: 0.8rem; color: var(--fg-muted); }
  #content { min-height: 58vh; resize: vertical; font-family: var(--font-mono); font-size: 0.95rem; line-height: 1.75; }
  @media (max-width: 1023px) { #content { min-height: 48vh; } }
  .cms-preview { min-height: 40vh; padding: 0.5rem 0.4rem; }
  .cms-tip { margin: 0.6rem 0.1rem 0; font-size: 0.78rem; color: var(--fg-muted); }
  .cms-foot { display: flex; justify-content: flex-end; }

  /* tools / templates — desktop: right side panel (like GitHub's sidebar) */
  .cms-tools { border: 1px solid var(--border); border-radius: 1rem; padding: 0.5rem 0.75rem 0.9rem; background: color-mix(in srgb, var(--bg) 94%, var(--fg) 2%); }
  .cms-tools.is-disabled { opacity: 0.45; pointer-events: none; }
  .cms-tool-group h3 { margin: 0.8rem 0 0.45rem; font-size: 0.72rem; letter-spacing: 0.12em; color: var(--fg-muted); font-weight: 600; }
  .cms-tool-row { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .cms-tool { min-height: 2.25rem; min-width: 2.25rem; padding: 0 0.7rem; font: inherit; font-size: 0.88rem; color: inherit; background: var(--bg);
    border: 1px solid var(--border-strong, var(--border)); border-radius: 0.6rem; cursor: pointer; white-space: nowrap; }
  .cms-tool:hover { background: color-mix(in srgb, var(--fg) 8%, var(--bg)); }
  .cms-tool { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; }
  .cms-tool .oi { flex: none; display: block; }
  .cms-tool.tpl { flex: 1 1 100%; justify-content: flex-start; text-align: left; }
  .cms-tool.tpl .oi { opacity: 0.75; }
  .cms-tool.chip-tpl { display: none; }
  .cms-sheet { display: none; }

  /* tools — mobile: a bar floating right above the keyboard */
  @media (max-width: 1023px) {
    .cms-tools { position: fixed; left: 0; right: 0; bottom: var(--kb, 0px); z-index: 60; display: none; padding: 0; border-radius: 0; border-width: 1px 0 0;
      background: var(--bg); box-shadow: 0 -6px 18px rgb(0 0 0 / 0.14); }
    html.cms-kb .cms-tools { display: block; }
    html.cms-kb .cms-page { padding-bottom: 9rem; }
    .cms-tools-scroll { display: flex; align-items: center; gap: 0.4rem; overflow-x: auto; padding: 0.45rem 0.6rem; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
    .cms-tools-scroll::-webkit-scrollbar { display: none; }
    .cms-tool-group { display: contents; }
    .cms-tool-group h3, .cms-tool-group.is-templates { display: none; }
    .cms-tool-row { display: contents; }
    .cms-tool { flex: none; min-height: 2.6rem; min-width: 2.6rem; font-size: 0.95rem; }
    .cms-tool.chip-tpl { display: inline-flex; background: var(--fg); color: var(--bg); border-color: var(--fg); }
    .cms-tool.chip-tpl .oi { opacity: 1; }
    .cms-tool-row .cms-tool:not(.chip-tpl):not(.tpl) { padding: 0 0.6rem; }
    .cms-tool.chip-tpl.is-on { opacity: 0.8; }
    .cms-sheet { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem; max-height: 40vh; overflow-y: auto; padding: 0.6rem; border-bottom: 1px solid var(--border); background: var(--bg); }
    .cms-sheet[hidden] { display: none; }
    .cms-sheet .cms-tool.tpl { flex: none; }
  }

  /* Blob library */
  .cms-blobs > summary { cursor: pointer; font-weight: 600; padding: 0.2rem 0; }
  .cms-blob-controls { display: flex; gap: 0.6rem; align-items: center; justify-content: space-between; flex-wrap: wrap; margin-top: 0.7rem; }
  .cms-seg { display: inline-flex; border: 1px solid var(--border-strong, var(--border)); border-radius: 0.7rem; overflow: hidden; }
  .cms-seg button { min-height: 2.4rem; padding: 0 0.95rem; font: inherit; font-size: 0.9rem; color: var(--fg-muted); background: transparent; border: 0; cursor: pointer; }
  .cms-seg button.is-on { background: var(--fg); color: var(--bg); font-weight: 600; }
  .cms-blob-list { display: grid; gap: 0.6rem; margin: 0.7rem 0; }
  .cms-blob { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 0.4rem 0.8rem; padding: 0.7rem; border: 1px solid var(--border); border-radius: 0.8rem; background: var(--bg); }
  .cms-blob-thumb { grid-row: span 2; display: grid; place-items: center; width: 96px; height: 96px; background: color-mix(in srgb, var(--fg) 5%, transparent); overflow: hidden; }
  .cms-blob-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cms-blob-info { min-width: 0; display: grid; gap: 0.2rem; align-content: start; }
  .cms-blob-info strong { font-size: 0.88rem; overflow-wrap: anywhere; }
  .cms-blob-info small { font-size: 0.78rem; color: var(--fg-muted); }
  .cms-blob-info small b.pub { color: #16a34a; } .cms-blob-info small b.draft { color: #d97706; }
  .cms-blob-info code { font-size: 0.72rem; color: var(--fg-dim, var(--fg-muted)); overflow-wrap: anywhere; user-select: all; }
  .cms-blob-acts { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .cms-blob-acts .cms-btn { min-height: 2.2rem; padding: 0 0.8rem; font-size: 0.85rem; }

