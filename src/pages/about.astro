---
import BaseLayout from '@layouts/BaseLayout.astro';
import { SITE_CONFIG } from '@lib/utils';
import { getAboutPage } from '@lib/about';
import { renderMarkdown } from '@lib/markdown';

const about = await getAboutPage();
const html = await renderMarkdown(about.content);
---
<BaseLayout title="关于" description={`关于 ${SITE_CONFIG.title}`}>
  <div class="container-narrow">
    <div class="page-header">
      <h1 class="page-title">{about.title}</h1>
      <p class="page-description">{SITE_CONFIG.description}</p>
    </div>
    <div class="markdown-content about-body" set:html={html} />
  </div>
</BaseLayout>
