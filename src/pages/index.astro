---
import BaseLayout from '@layouts/BaseLayout.astro';
import PostCard from '@components/PostCard.astro';
import GrokOrb from '@components/GrokOrb.astro';
import { getAllPosts, getAllCategories, getAllTags } from '@lib/posts';
import { SITE_CONFIG } from '@lib/utils';
const allPosts = await getAllPosts();
const allCategories = await getAllCategories();
const allTags = await getAllTags();
const recentPosts = allPosts.slice(0, 6);
---
<BaseLayout title="首页" description={SITE_CONFIG.description}>
  <div class="container">
    <section class="hero-section">
      <div class="hero-copy">
        <h1 class="hero-title">{SITE_CONFIG.title}</h1>
        <div class="hero-stats">
          <div class="hero-stat"><span class="hero-stat-number">{allPosts.length}</span><span class="hero-stat-label">篇文章</span></div>
          <div class="hero-stat"><span class="hero-stat-number">{allCategories.length}</span><span class="hero-stat-label">个分类</span></div>
          <div class="hero-stat"><span class="hero-stat-number">{allTags.length}</span><span class="hero-stat-label">个标签</span></div>
        </div>
      </div>
      <div class="hero-orb-wrap" aria-label="点击切换小球形状">
        <GrokOrb size={220} state="idle" mood="hold" follow={true} class="hero-orb" />
      </div>
    </section>
    <section>
      <div class="section-head">
        <h2>最新文章</h2>
        <a href="/posts" class="link-arrow">查看全部 →</a>
      </div>
      <div class="posts-list">
        {recentPosts.map(post => (<PostCard post={post} />))}
      </div>
    </section>
  </div>
</BaseLayout>
