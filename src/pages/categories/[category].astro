---
import BaseLayout from '@layouts/BaseLayout.astro';
import PostList from '@components/PostList.astro';
import { getPostsByCategory, getAllPosts } from '@lib/posts';
import { SITE_CONFIG, paginate, slugify, extractCategories } from '@lib/utils';
const { category } = Astro.params;
const allPosts = await getAllPosts();
const categories = extractCategories(allPosts);
const matchedCategory = categories.find(c => slugify(c.name) === category);
const categoryName = matchedCategory?.name || category;
const categoryPosts = await getPostsByCategory(categoryName);
const page = Number(Astro.url.searchParams.get('page')) || 1;
const { items: posts, totalPages } = paginate(categoryPosts, page, SITE_CONFIG.postsPerPage);
---
<BaseLayout title={categoryName} description={`${categoryName} 分类下的所有文章`}>
  <div class="container">
    <div class="page-header">
      <a href="/categories" style="font-size:0.9rem;color:var(--color-text-secondary);">← 返回全部分类</a>
      <h1 class="page-title" style="margin-top:0.5rem;">{categoryName}</h1>
      <p class="page-description">共 {categoryPosts.length} 篇文章</p>
    </div>
    <PostList posts={posts} page={page} totalPages={totalPages} baseUrl={`/categories/${slugify(categoryName)}`} emptyMessage="该分类下暂无文章" />
  </div>
</BaseLayout>
