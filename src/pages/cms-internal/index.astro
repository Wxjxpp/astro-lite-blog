---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getAdminPath, isAdminAuthenticated } from '@lib/admin-auth';

const loggedIn = isAdminAuthenticated(Astro.request);
Astro.response.status = 200;
---
<BaseLayout title="博客管理" description="博客内容管理后台">
  <main class="container-narrow cms-page">
    {loggedIn ? (
      <>
        <header class="cms-header"><div><p class="label">CONTENT STUDIO</p><h1>文章管理</h1></div><a href="/api/auth/logout">退出登录</a></header>
        <section class="cms-grid">
          <aside class="cms-list"><button id="newPost" class="cms-button primary">＋ 新建文章</button><div id="postList">正在加载…</div></aside>
          <section class="cms-editor">
            <form id="postForm">
              <input type="hidden" id="originalSlug" />
              <label>标题<input id="title" required /></label>
              <div class="cms-two"><label>Slug<input id="slug" required pattern="[a-z0-9-]+" /></label><label>分类<input id="category" required /></label></div>
              <label>摘要<textarea id="description" rows="2" required></textarea></label>
              <div class="cms-two"><label>发布日期<input id="pubDate" type="date" required /></label><label>作者<input id="author" /></label></div>
              <label>封面 URL<input id="cover" type="url" /></label>
              <label>标签（逗号分隔）<input id="tags" /></label>
              <label>正文 Markdown<textarea id="content" rows="18" required></textarea></label>
              <label class="cms-check"><input id="draft" type="checkbox" /> 保存为草稿</label>
              <div class="cms-actions"><button class="cms-button primary" type="submit">保存文章</button><button class="cms-button" type="button" id="previewButton">预览</button><button class="cms-button danger" type="button" id="deleteButton">删除</button></div>
              <p id="status" class="cms-status"></p>
            </form>
            <article id="preview" class="markdown-content cms-preview" hidden></article>
          </section>
        </section>
      </>
    ) : (
      <section class="cms-login"><p class="label">PRIVATE CONTENT STUDIO</p><h1>博客管理</h1><p>管理入口不是安全边界，登录仍需 GitHub OAuth 和账号白名单。</p><a class="cms-button primary" href="/api/auth/github">使用 GitHub 登录</a></section>
    )}
  </main>
</BaseLayout>

{loggedIn && <script>
  import { marked } from 'marked';
  const $ = (id) => document.getElementById(id);
  const fields = ['title','slug','description','pubDate','author','cover','tags','content','draft'];
  let current = null;
  const status = (text, error = false) => { $('status').textContent = text; $('status').style.color = error ? '#d33' : ''; };
  const fill = (post = {}) => { current = post.slug || null; fields.forEach(k => { const el = $(k); if (!el) return; if (k === 'tags') el.value = (post.tags || []).join(', '); else if (k === 'draft') el.checked = Boolean(post.draft); else if (k === 'pubDate') el.value = post.pubDate ? new Date(post.pubDate).toISOString().slice(0,10) : new Date().toISOString().slice(0,10); else el.value = post[k] || ''; }); $('originalSlug').value = current || ''; $('preview').hidden = true; };
  const load = async () => { const r = await fetch('/api/admin/posts'); const data = await r.json(); if (!r.ok) return status(data.error || '加载失败', true); $('postList').innerHTML = data.length ? data.map(p => `<button class="cms-post" data-slug="${p.slug}"><strong>${p.title}</strong><small>${p.draft ? '草稿' : '已发布'} · ${p.slug}</small></button>`).join('') : '<p>还没有数据库文章。</p>'; document.querySelectorAll('.cms-post').forEach(b => b.onclick = async () => { const r = await fetch('/api/admin/posts/' + b.dataset.slug); fill(await r.json()); }); };
  $('newPost').onclick = () => fill();
  $('postForm').onsubmit = async e => { e.preventDefault(); const body = { title:$('title').value, slug:$('slug').value, description:$('description').value, pubDate:$('pubDate').value, author:$('author').value, cover:$('cover').value, tags:$('tags').value.split(',').map(x=>x.trim()).filter(Boolean), content:$('content').value, draft:$('draft').checked }; const r = await fetch('/api/admin/posts', { method:'POST', headers:{'content-type':'application/json'}, body:JSON.stringify(body) }); const data = await r.json(); status(r.ok ? '保存成功' : (data.error || '保存失败'), !r.ok); if(r.ok){ current=data.slug; await load(); } };
  $('previewButton').onclick = () => { $('preview').innerHTML = marked.parse($('content').value); $('preview').hidden = false; };
  $('deleteButton').onclick = async () => { if(!current || !confirm('确认删除这篇数据库文章？')) return; const r=await fetch('/api/admin/posts/'+current,{method:'DELETE'}); status(r.ok?'删除成功':'删除失败',!r.ok); if(r.ok){fill();load();} };
  fill(); load();
</script>}

<style>
  .cms-page { padding-block: var(--space-3xl); } .cms-header,.cms-grid,.cms-two,.cms-actions { display:grid; gap:1rem; } .cms-header { grid-template-columns:1fr auto; align-items:end; border-bottom:1px solid var(--border); padding-bottom:1rem; } .cms-grid { grid-template-columns:240px 1fr; margin-top:2rem; } .cms-list { display:flex; flex-direction:column; gap:1rem; } .cms-post { text-align:left; background:transparent; border:1px solid var(--border); padding:.8rem; cursor:pointer; } .cms-post small { display:block; margin-top:.4rem; opacity:.65; } .cms-editor form { display:grid; gap:1rem; } .cms-editor label { display:grid; gap:.35rem; } .cms-editor input,.cms-editor textarea { width:100%; box-sizing:border-box; border:1px solid var(--border); background:transparent; padding:.7rem; font:inherit; color:inherit; } .cms-two { grid-template-columns:1fr 1fr; } .cms-actions { grid-template-columns:repeat(3,auto); justify-content:start; } .cms-button { border:1px solid var(--border); background:transparent; color:inherit; padding:.7rem 1rem; cursor:pointer; text-decoration:none; } .cms-button.primary { background:var(--text); color:var(--background); } .cms-button.danger { color:#d33; } .cms-status { min-height:1.2em; } .cms-preview { border-top:1px solid var(--border); margin-top:2rem; padding-top:2rem; } .cms-login { max-width:34rem; margin:8rem auto; } .cms-login p { margin-block:1rem; } @media(max-width:700px){ .cms-grid,.cms-two { grid-template-columns:1fr; } .cms-header { grid-template-columns:1fr; } }
</style>
