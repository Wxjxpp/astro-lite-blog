---
import BaseLayout from '@layouts/BaseLayout.astro';
import TagBadge from '@components/TagBadge.astro';
import CommentSection from '@components/CommentSection.astro';
import { getPostBySlug, getRelatedPosts, getPrevNextPosts } from '@lib/posts';
import { formatDate, slugify } from '@lib/utils';
import type { PostFrontmatter } from '@types/index';
import { render } from 'astro:content';

// SSR 模式下从 URL 参数动态获取文章（Astro 5 Content Layer）
const { slug } = Astro.params;
const post = slug ? await getPostBySlug(slug) : undefined;

if (!post) {
  return Astro.redirect('/404');
}

const { Content } = await render(post);
const data = post.data as PostFrontmatter;

const relatedPosts = await getRelatedPosts(post.id, 4);
const { prev, next } = await getPrevNextPosts(post.id);
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={data.cover}
  type="article"
>
  <article class="container-narrow">
    <!-- 文章头部 -->
    <header class="post-header">
      <a href={`/categories/${slugify(data.category)}`} class="post-card-category">{data.category}</a>
      <h1 class="post-title">{data.title}</h1>
      <div class="post-meta">
        <span class="post-meta-item">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          {formatDate(data.pubDate)}
        </span>
        {data.updatedDate && (
          <span class="post-meta-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 4v6h6"/>
              <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
            </svg>
            更新于 {formatDate(data.updatedDate)}
          </span>
        )}
        {data.author && (
          <span class="post-meta-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
            {data.author}
          </span>
        )}
      </div>
    </header>

    <!-- 封面图 -->
    {data.cover && (
      <img
        src={data.cover}
        alt={data.title}
        class="post-cover"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    )}

    <!-- 文章正文 -->
    <div class="markdown-content post-body">
      <Content />
    </div>

    <!-- 文章标签 -->
    {data.tags.length > 0 && (
      <div class="post-tags-row">
        <span class="label">标签</span>
        {data.tags.map(tag => (
          <TagBadge tag={tag} size="md" />
        ))}
      </div>
    )}

    <!-- 上一篇/下一篇 -->
    {(prev || next) && (
      <nav class="post-nav">
        {prev ? (
          <a href={`/posts/${prev.slug}`} class="post-nav-card">
            <div class="post-nav-label">← 上一篇</div>
            <div class="post-nav-title">{prev.title}</div>
          </a>
        ) : <span />}
        {next ? (
          <a href={`/posts/${next.slug}`} class="post-nav-card next">
            <div class="post-nav-label">下一篇 →</div>
            <div class="post-nav-title">{next.title}</div>
          </a>
        ) : <span />}
      </nav>
    )}

    <!-- 相关文章 -->
    {relatedPosts.length > 0 && (
      <section style="margin-top: var(--space-3xl);">
        <h2 class="post-section-title">相关文章</h2>
        <div class="related-grid">
          {relatedPosts.map(rp => (
            <a href={`/posts/${rp.slug}`} class="related-card">
              <span class="post-card-category">{rp.category}</span>
              <div class="related-title">{rp.title}</div>
              <div class="related-date">{formatDate(rp.pubDate)}</div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- 评论区 -->
    <CommentSection term={post.id} />
  </article>
</BaseLayout>