---
import BaseLayout from '@layouts/BaseLayout.astro';
import TagBadge from '@components/TagBadge.astro';
import CommentSection from '@components/CommentSection.astro';
import { getPostBySlug, getRelatedPosts, getPrevNextPosts } from '@lib/posts';
import { formatDate, slugify } from '@lib/utils';
import type { PostFrontmatter } from '@types/index';
import { render } from 'astro:content';
import { marked } from 'marked';
import hljs from 'highlight.js/lib/common';
import markedKatex from 'marked-katex-extension';
import markedFootnote from 'marked-footnote';

// SSR 模式下从 URL 参数动态获取文章（Astro 5 Content Layer）
const { slug } = Astro.params;
const post = slug ? await getPostBySlug(slug) : undefined;

if (!post) {
  return Astro.redirect('/404');
}

const Content = post.source === 'file' && post.entry ? (await render(post.entry)).Content : undefined;
const data = post.data as PostFrontmatter;
marked.use(markedKatex({ throwOnError: false, nonStandard: true }));
marked.use(markedFootnote());
marked.use({
  renderer: {
    code({ text, lang }) {
      const language = lang?.trim().split(/\s+/)[0].replace(/[^a-zA-Z0-9_+-]/g, '');
      const highlighted = language && hljs.getLanguage(language)
        ? hljs.highlight(text, { language }).value
        : hljs.highlightAuto(text).value;
      const languageClass = language ? ` class="hljs language-${language}"` : ' class="hljs"';
      return `<pre><code${languageClass}>${highlighted}</code></pre>`;
    },
  },
});
const databaseHtml = post.source === 'database' ? await marked.parse(post.body || '') : '';

const RELATED_VISIBLE = 2;
const relatedPosts = await getRelatedPosts(post.id, 8);
const { prev, next } = await getPrevNextPosts(post.id);
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={data.cover}
  type="article"
>
  <article class="container-narrow" data-post-slug={post.id}>
    <!-- 文章头部 -->
    <header class="post-header">
      <a href={`/categories/${slugify(data.category)}`} class="post-card-category">{data.category}</a>
      <h1 class="post-title">{data.title}</h1>
      <div class="post-meta">
        <span class="post-meta-item">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          {formatDate(data.pubDate)}
        </span>
        {data.updatedDate && (
          <span class="post-meta-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 4v6h6"/>
              <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/>
            </svg>
            更新于 {formatDate(data.updatedDate)}
          </span>
        )}
        {data.author && (
          <span class="post-meta-item">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
            {data.author}
          </span>
        )}
      </div>
    </header>

    <!-- 封面图 -->
    {data.cover && (
      <img
        src={data.cover}
        alt={data.title}
        class="post-cover"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    )}

    <!-- 文章正文 -->
    <div class="markdown-content post-body">
      {Content ? <Content /> : <Fragment set:html={databaseHtml} />}
    </div>

    <!-- 文章标签 -->
    {data.tags.length > 0 && (
      <div class="post-tags-row">
        <span class="label">标签</span>
        {data.tags.map(tag => (
          <TagBadge tag={tag} size="md" />
        ))}
      </div>
    )}

    <!-- 上一篇/下一篇 -->
    {(prev || next) && (
      <nav class="post-nav" aria-label="上一篇与下一篇">
        {prev && (
          <a href={`/posts/${prev.slug}`} class="post-nav-card prev">
            <div class="post-nav-label">← 上一篇</div>
            <div class="post-nav-title">{prev.title}</div>
          </a>
        )}
        {next && (
          <a href={`/posts/${next.slug}`} class="post-nav-card next">
            <div class="post-nav-label">下一篇 →</div>
            <div class="post-nav-title">{next.title}</div>
          </a>
        )}
      </nav>
    )}

    <!-- 相关文章：行式列表，默认只显示前 3 条，其余折叠 -->
    {relatedPosts.length > 0 && (
      <section class="related-section">
        <h2 class="post-section-title">相关文章</h2>
        <ul class="related-list">
          {relatedPosts.slice(0, RELATED_VISIBLE).map(rp => (
            <li>
              <a href={`/posts/${rp.slug}`} class="related-row">
                <span class="related-cat">{rp.category}</span>
                <span class="related-name">{rp.title}</span>
                <time class="related-when">{formatDate(rp.pubDate)}</time>
              </a>
            </li>
          ))}
        </ul>
        {relatedPosts.length > RELATED_VISIBLE && (
          <details class="related-more">
            <summary><span class="when-closed">展开更多（{relatedPosts.length - RELATED_VISIBLE}）</span><span class="when-open">收起</span></summary>
            <ul class="related-list">
              {relatedPosts.slice(RELATED_VISIBLE).map(rp => (
                <li>
                  <a href={`/posts/${rp.slug}`} class="related-row">
                    <span class="related-cat">{rp.category}</span>
                    <span class="related-name">{rp.title}</span>
                    <time class="related-when">{formatDate(rp.pubDate)}</time>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )}
      </section>
    )}

    <!-- 评论区 -->
    <CommentSection term={post.id} />
  </article>
</BaseLayout>

<script>
  const recordPostView = async () => {
    const slug = document.querySelector<HTMLElement>('[data-post-slug]')?.dataset.postSlug;
    if (!slug) return;
    const key = `blog:viewed:${slug}`;
    try {
      if (sessionStorage.getItem(key)) return;
      sessionStorage.setItem(key, 'pending');
    } catch {}
    try {
      const response = await fetch(`/api/posts/${encodeURIComponent(slug)}/view`, { method: 'POST', keepalive: true });
      if (response.ok) sessionStorage.setItem(key, '1');
      else sessionStorage.removeItem(key);
    } catch {
      try { sessionStorage.removeItem(key); } catch {}
    }
  };
  document.addEventListener('astro:page-load', recordPostView);
  recordPostView();

  const copyText = async (text: string) => {
    if (navigator.clipboard && window.isSecureContext) {
      await navigator.clipboard.writeText(text);
      return;
    }
    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    document.execCommand('copy');
    textarea.remove();
  };

  const initCodeCopy = () => {
    document.querySelectorAll<HTMLElement>('.post-body pre').forEach((block) => {
      if (block.dataset.copyReady === 'true') return;
      block.dataset.copyReady = 'true';

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'code-copy-button';
      button.textContent = '复制';
      button.setAttribute('aria-label', '复制代码');

      button.addEventListener('click', async () => {
        const code = block.querySelector('code')?.textContent ?? '';
        try {
          await copyText(code);
          button.textContent = '已复制';
          button.classList.add('copied');
          window.setTimeout(() => {
            button.textContent = '复制';
            button.classList.remove('copied');
          }, 1600);
        } catch {
          button.textContent = '复制失败';
          window.setTimeout(() => { button.textContent = '复制'; }, 1600);
        }
      });

      block.appendChild(button);
    });
  };
  document.addEventListener('astro:page-load', initCodeCopy);
</script>
