# Site
SITE_URL=https://wxjxpp.online
SITE_NAME=Wxjxpp Blog
SITE_DESCRIPTION=67676767

# Twikoo comments (self-hosted cloud function, independent of any Git repository)
PUBLIC_TWIKOO_ENV_ID=

# Blog content database (use a separate database/collection from Twikoo)
BLOG_MONGODB_URI=
BLOG_MONGODB_DATABASE=astro_blog

# Optional Vercel KV / Upstash Redis storage for blog content.
# When both are present, KV is preferred and MongoDB is kept as migration backup.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Some Upstash/Vercel integrations prefix these as follows; either naming style works.
UPSTASH_REDIS_REST_KV_REST_API_URL=
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=

# Vercel Blob image uploads
BLOB_READ_WRITE_TOKEN=

# Private content studio
# Use a long random path segment, e.g. studio-3f8c...; do not use /admin.
BLOG_ADMIN_PATH=
BLOG_SESSION_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ADMIN_LOGIN=Wxjxpp

# Cloudflare Turnstile on the admin login (https://dash.cloudflare.com/?to=/:account/turnstile).
# Both are server-side only (no PUBLIC_ prefix). Site key is rendered into the login page at request time.
# If either is empty the check is skipped and the login page shows a warning.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional, server-side only (no PUBLIC_ prefix). Any random string; set the SAME value on the
# Twikoo Vercel project so it trusts the visitor IP this site forwards (see twikoo-api-index.js).
TWIKOO_PROXY_SECRET=
