# Site
SITE_URL=https://your-blog-domain.vercel.app
SITE_NAME=Astro Lite Blog
SITE_DESCRIPTION=A full-featured Astro blog

# GitHub OAuth (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=https://your-blog-domain.vercel.app/api/auth/callback

# Session
SESSION_SECRET=change-this-to-a-long-random-string-at-least-32-chars

# Vercel KV (auto-injected when Vercel KV is connected)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Vercel Blob (auto-injected when Vercel Blob is connected)
# BLOB_READ_WRITE_TOKEN=
