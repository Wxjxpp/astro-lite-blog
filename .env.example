# Site
SITE_URL=https://your-blog-domain.vercel.app
SITE_NAME=Astro Lite Blog
SITE_DESCRIPTION=A full-featured Astro blog

# Twikoo comments (self-hosted cloud function, independent of any Git repository)
PUBLIC_TWIKOO_ENV_ID=

# Blog content database (use a separate database/collection from Twikoo)
BLOG_MONGODB_URI=
BLOG_MONGODB_DATABASE=astro_blog

# Private content studio
# Use a long random path segment, e.g. studio-3f8c...; do not use /admin.
BLOG_ADMIN_PATH=
BLOG_SESSION_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ADMIN_LOGIN=Wxjxpp
