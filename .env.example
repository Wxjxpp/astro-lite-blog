# Site
SITE_URL=https://your-blog-domain.vercel.app
SITE_NAME=Astro Lite Blog
SITE_DESCRIPTION=A full-featured Astro blog

# Giscus comments (generate these at https://giscus.app)
# Requires a public GitHub repository with Discussions enabled and the giscus app installed.
PUBLIC_GISCUS_REPO=owner/repo
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=
# Optional: pathname | url | title | og:title | specific
PUBLIC_GISCUS_MAPPING=pathname